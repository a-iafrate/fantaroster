@namespace Roster.Ui.Components

@* Bottom sheet on phones, centered dialog from 640 px. Closes with Escape or a tap outside; moves focus in on open. *@
<button type="button" class="ds-scrim" tabindex="-1" aria-label="@CloseLabel" @onclick="OnClose"></button>
<div class="ds-modal" role="dialog" aria-modal="true" aria-labelledby="@_titleId" tabindex="-1" @ref="_dialog" @onkeydown="OnKeyDown">
    <div class="ds-sheet__grabber" aria-hidden="true"></div>
    <h2 class="ds-modal__title" id="@_titleId">@Title</h2>
    @ChildContent
    @if (Actions is not null)
    {
        <div class="ds-modal__actions">@Actions</div>
    }
</div>

@code {
    private readonly string _titleId = $"modal-title-{Guid.NewGuid():N}";
    private ElementReference _dialog;
    private bool _focused;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Accessible name of the area behind the dialog that closes it.</summary>
    [Parameter] public string CloseLabel { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public RenderFragment? Actions { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_focused)
        {
            _focused = true;
            await _dialog.FocusAsync();
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await OnClose.InvokeAsync();
        }
    }
}
