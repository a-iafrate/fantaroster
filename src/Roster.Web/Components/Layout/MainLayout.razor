@inherits LayoutComponentBase
@using Microsoft.Extensions.Options
@using Roster.Web.Options
@inject IStringLocalizer<SharedResource> Loc
@inject IOptions<BrandOptions> Brand
@inject TimeProvider Time

<a href="#main" class="skip-link">@Loc["SkipToContent"]</a>

<div class="pub">
    <header class="pub-header">
        <a href="/" class="pub-brand"><img src="assets/logo-r.svg" alt="" /><BrandWordmark /></a>

        <nav class="pub-nav" aria-label="@Loc["MainNavLabel"]">
            <a href="/#how" class="pub-nav__link">@Loc["PubNavHow"]</a>
            <a href="/#domains" class="pub-nav__link">@Loc["PubNavDomains"]</a>
        </nav>

        <div class="pub-actions">
            <a href="/j" class="ds-btn ds-btn--link"><i class="icon-qr-code" aria-hidden="true"></i>@Loc["PubHaveCodeShort"]</a>
            <a href="/login" class="ds-btn ds-btn--link">@Loc["PubSignIn"]</a>
            <a href="/organizer/create-game" class="ds-btn ds-btn--primary">@Loc["PubCreate"]</a>
        </div>

        @* Phones: a native disclosure, so the menu works with the keyboard and without JavaScript. *@
        <details class="pub-menu">
            <summary class="pub-menu__button" aria-label="@Loc["PubMenu"]"><i class="icon-menu" aria-hidden="true"></i></summary>
            <div class="pub-menu__panel">
                <a href="/#how" class="pub-menu__link">@Loc["PubNavHow"]<i class="icon-chevron-right" aria-hidden="true"></i></a>
                <a href="/#domains" class="pub-menu__link">@Loc["PubNavDomains"]<i class="icon-chevron-right" aria-hidden="true"></i></a>
                <div class="pub-menu__settings"><ThemeToggle CssClass="ds-chip" /></div>
                <a href="/j" class="ds-btn ds-btn--l ds-btn--block ds-btn--secondary"><i class="icon-qr-code" aria-hidden="true"></i>@Loc["PubHaveCode"]</a>
                <a href="/login" class="ds-btn ds-btn--l ds-btn--block ds-btn--secondary">@Loc["PubSignIn"]</a>
                <a href="/organizer/create-game" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary">@Loc["PubCreate"]</a>
            </div>
        </details>
    </header>

    <main id="main" class="pub-main">
        @Body
    </main>

    <footer class="pub-footer" data-theme="dark">
        <div class="pub-footer__content">
            <div class="pub-footer__brand">
                <span class="pub-footer__logo"><img src="assets/logo-r.svg" alt="" /><BrandWordmark /></span>
                <p>@Loc["HeroTitle"]</p>
            </div>
            <nav class="pub-footer__col" aria-label="@Loc["PubFooterPlay"]">
                <h2>@Loc["PubFooterPlay"]</h2>
                <a href="/j">@Loc["PubHaveCode"]</a>
                <a href="/#how">@Loc["PubNavHow"]</a>
            </nav>
            <nav class="pub-footer__col" aria-label="@Loc["PubFooterOrganize"]">
                <h2>@Loc["PubFooterOrganize"]</h2>
                <a href="/login">@Loc["PubSignIn"]</a>
                <a href="/organizer/create-game">@Loc["PubCreate"]</a>
                <a href="/#domains">@Loc["PubNavDomains"]</a>
            </nav>
        </div>
        <div class="pub-footer__bottom">
            <span>@string.Format(Loc["PubCopyright"], Time.GetUtcNow().Year, Brand.Value.Name)</span>
            <ThemeToggle CssClass="pub-footer__chip" />
        </div>
    </footer>
</div>

<Roster.Web.Client.Layout.ErrorBanner />
