@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Loc

<div class="org-layout">
    <div class="org-sidebar">
        <a href="/organizer" class="org-brand">
            <img src="/assets/logo-r.svg" alt="">
            <span><b>fanta</b>roster</span>
        </a>
        
        <nav class="org-nav">
            <a href="/organizer" class="org-nav-item active">
                <i class="icon-layout-grid"></i> @Loc["DashboardTitle"]
            </a>
            <a href="/organizer/templates" class="org-nav-item">
                <i class="icon-copy"></i> @Loc["NavTemplates"]
            </a>
            <a href="/organizer/billing" class="org-nav-item">
                <i class="icon-credit-card"></i> @Loc["NavBilling"]
            </a>
            <a href="/organizer/help" class="org-nav-item">
                <i class="icon-life-buoy"></i> @Loc["NavHelp"]
            </a>
        </nav>

        <div class="org-plan">
            <div class="org-plan-title">@Loc["PlanFree"]</div>
            <div class="org-plan-desc">@Loc["PlanFreeDesc"]</div>
            <a href="/organizer/billing" class="org-plan-link">@Loc["PlanUpgrade"]</a>
        </div>

        <div class="org-account-btn">
            <div class="org-avatar">CM</div>
            <div class="org-account-info">
                <div class="org-account-name">Chiara Monti</div>
                <div class="org-account-email">chiara@dotnetemilia.it</div>
            </div>
            <i class="icon-chevrons-up-down"></i>
        </div>
    </div>
    
    <main class="org-main">
        @Body
    </main>
</div>
