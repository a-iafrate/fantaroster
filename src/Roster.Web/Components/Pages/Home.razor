@page "/"
@using System.Globalization
@using Microsoft.Extensions.Options
@using Roster.DomainPacks
@using Roster.Web.Options
@inject IDomainPackLoader DomainPacks
@inject IOptions<BrandOptions> Brand
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Brand.Value.Name - @Loc["HeroTitle"]</PageTitle>

@* Landing (mockup 04, screen 17). Everything about a use case comes from the domain packs, never from this page. *@
<section class="hero">
    <div class="hero__text">
        <h1 class="hero__title">@Loc["HeroTitle"]</h1>
        <p class="hero__sub">@Loc["HeroSub"]</p>
        <div class="hero__ctas">
            <a href="/organizer/create-game" class="ds-btn ds-btn--l ds-btn--primary">@Loc["PubCreate"]</a>
            <a href="/j" class="ds-btn ds-btn--l ds-btn--secondary"><i class="icon-qr-code" aria-hidden="true"></i>@Loc["PubHaveCode"]</a>
        </div>
    </div>
    <div class="hero__art" aria-hidden="true">
        <span class="hero__card hero__card--cyan"></span>
        <span class="hero__card hero__card--blue"></span>
        <span class="hero__card hero__card--main">
            <span class="hero__card-top"><i class="icon-star"></i><span class="ds-points">+10</span></span>
            <span class="hero__card-label">@Loc["HeroCardLabel"]</span>
        </span>
    </div>
</section>

<section class="band band--surface" id="how" aria-labelledby="how-title">
    <h2 class="band__title" id="how-title">@Loc["HowTitle"]</h2>
    <ol class="steps">
        <li class="step"><span class="step__n" aria-hidden="true">1</span><h3 class="step__title">@Loc["How1Title"]</h3><p class="step__desc">@Loc["How1Desc"]</p></li>
        <li class="step"><span class="step__n" aria-hidden="true">2</span><h3 class="step__title">@Loc["How2Title"]</h3><p class="step__desc">@Loc["How2Desc"]</p></li>
        <li class="step"><span class="step__n" aria-hidden="true">3</span><h3 class="step__title">@Loc["How3Title"]</h3><p class="step__desc">@Loc["How3Desc"]</p></li>
    </ol>
</section>

<section class="band" id="domains" aria-labelledby="domains-title">
    <h2 class="band__title" id="domains-title">@Loc["DomainsTitle"]</h2>
    <p class="band__desc">@Loc["DomainsDesc"]</p>
    <ul class="domains">
        @foreach (var pack in DomainPacks.GetAllPacks())
        {
            <li class="domain">
                <i class="@(string.IsNullOrEmpty(pack.Icon) ? "icon-sparkles" : pack.Icon)" aria-hidden="true"></i>
                <h3 class="domain__title">@Localized(pack.Name, pack.Id)</h3>
                <p class="domain__desc">@Localized(pack.Description, string.Empty)</p>
            </li>
        }
    </ul>
</section>

@code {
    private static string Localized(IReadOnlyDictionary<string, string> values, string fallback) =>
        values.TryGetValue(CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, out var value) || values.TryGetValue("en", out value) ? value : fallback;
}
