@inject IStringLocalizer<SharedResource> Loc
@inject IBrandAccessor Brand

<PageTitle>@Loc[Prefix + "Title"]</PageTitle>

<article class="legal">
    <h1 class="legal__title">@Loc[Prefix + "Title"]</h1>
    <p class="legal__intro">@string.Format(Loc[Prefix + "Intro"], Brand.Current.Name)</p>

    @for (var i = 1; i <= Sections; i++)
    {
        <section class="legal__section">
            <h2 class="legal__heading">@Loc[$"{Prefix}S{i}Title"]</h2>
            <p>@Loc[$"{Prefix}S{i}Body"]</p>
        </section>
    }

    <p class="legal__other">
        <a href="@OtherHref">@Loc[OtherLabel]</a>
    </p>
</article>

@code {
    /// <summary>Resource key prefix of the document ("Privacy" or "Terms").</summary>
    [Parameter, EditorRequired]
    public string Prefix { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public int Sections { get; set; }

    [Parameter, EditorRequired]
    public string OtherHref { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string OtherLabel { get; set; } = string.Empty;
}
