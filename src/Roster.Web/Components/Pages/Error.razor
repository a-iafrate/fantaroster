@page "/Error"
@using System.Diagnostics
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["ErrorTitle"]</PageTitle>

<div class="notice-page">
    <h1 class="notice-page__title">@Loc["ErrorTitle"]</h1>
    <p class="notice-page__text">@Loc["ErrorBody"]</p>

    @if (ShowRequestId)
    {
        <p class="notice-page__id">@string.Format(Loc["ErrorRequestId"], RequestId)</p>
    }

    <a href="/" class="ds-btn ds-btn--l ds-btn--primary">@Loc["BackHome"]</a>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
