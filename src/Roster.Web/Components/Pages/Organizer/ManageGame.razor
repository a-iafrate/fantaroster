@page "/organizer/games/{Id:guid}/{Section?}"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Roster.Application.Ports.Data
@using Roster.Domain.Games
@using Roster.Web.Components.Layout
@attribute [Authorize]
@inject IGameRepository GameRepository
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Navigation
@inject OrganizerContext Context
@implements IDisposable

<PageTitle>@Loc["ManageGameTitle"]</PageTitle>

@if (IsLoading)
{
    <p class="ds-muted" role="status">@Loc["Loading"]</p>
}
else if (Game is null)
{
    <div class="ds-page">
        <h1 class="ds-page-title">@Loc["GameNotFound"]</h1>
        <a href="/organizer" class="ds-btn ds-btn--primary">@Loc["BackToDashboard"]</a>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p class="ds-alert mg-error" role="alert">@ErrorMessage</p>
    }

    @switch (Section?.ToLowerInvariant())
    {
        case "elements":
            <ElementsTab GameId="Id" GameState="Game.State" OnError="HandleError" />
            break;
        case "rules":
            <RulesTab GameId="Id" GameState="Game.State" OnError="HandleError" />
            break;
        case "referees":
            <RefereesTab GameId="Id" OnError="HandleError" />
            break;
        case "control":
            <ControlTab Game="Game" OnChanged="LoadGame" />
            break;
        case "materials":
            <AssetsTab Game="Game" OnError="HandleError" />
            break;
        case "settings":
            <SettingsTab Game="Game" OnSaved="LoadGame" OnError="HandleError" />
            break;
        default:
            <OverviewTab Game="Game" />
            break;
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    [Parameter]
    public string? Section { get; set; }

    private Game? Game { get; set; }
    private bool IsLoading = true;
    private string? ErrorMessage;
    private string? _lastSection;

    protected override async Task OnParametersSetAsync()
    {
        // Moving between sections must not leave an error from the previous one on screen.
        if (!string.Equals(_lastSection, Section, StringComparison.Ordinal))
        {
            ErrorMessage = null;
            _lastSection = Section;
        }

        if (Game?.Id != Id)
        {
            IsLoading = true;
            await LoadGame();
            IsLoading = false;
        }
    }

    private void HandleError(string message) => ErrorMessage = message;

    private async Task LoadGame()
    {
        Game = await GameRepository.GetByIdAsync(Id);
        Context.SetGame(Game is null ? null : new OrganizerGameInfo(Game.Id, Game.Name, Game.State));
    }

    public void Dispose() => Context.SetGame(null);
}
