@page "/organizer/create-game"
@using Microsoft.AspNetCore.Authorization
@using Roster.Application.Ports
@using Roster.DomainPacks
@using Roster.Plugins.Abstractions
@using Roster.Web.Components.Pages.Organizer
@attribute [Authorize]
@inject IDomainPackLoader DomainPackLoader
@inject IGameCreationService GameCreationService
@inject IPluginRegistry PluginRegistry
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Create Game</PageTitle>

<div style="height: 100vh; display: flex; flex-direction: column; background: var(--color-bg); color: var(--color-ink);">
    <!-- Header / Stepper -->
    <div style="height:72px; flex:none; padding:0 40px; display:flex; align-items:center; gap:24px; border-bottom:1px solid var(--color-line); background:var(--color-surface)">
        <a href="/organizer" style="color: inherit; text-decoration: none;"><i class="icon-x" style="font-size:22px"></i></a>
        <div style="font-size:16px; font-weight:800">Nuova partita</div>
        <div style="margin-left:40px; display:flex; align-items:center; gap:8px; font-size:14px; font-weight:600">
            @foreach (var step in Steps)
            {
                var isDone = step.Number < CurrentStep;
                var isCurrent = step.Number == CurrentStep;
                var fg = isCurrent ? "var(--color-ink)" : "var(--color-ink-2)";
                var bg = isDone || isCurrent ? "var(--color-primary)" : "transparent";
                var numFg = isDone || isCurrent ? "var(--color-on-primary)" : "var(--color-ink-2)";
                var bd = isDone || isCurrent ? "none" : "1.5px solid var(--color-line-strong)";
                
                <div style="display:flex; align-items:center; gap:8px; color:@fg">
                    <span style="width:26px; height:26px; border-radius:7px; background:@bg; color:@numFg; border:@bd; display:flex; align-items:center; justify-content:center; font-weight:800; font-size:13px">
                        @(isDone ? "✓" : step.Number.ToString())
                    </span>
                    @step.Label
                    @if (step.Number < Steps.Length)
                    {
                        <span style="width:20px; height:2px; background:var(--color-line-strong); margin-left:4px"></span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Main Content Area -->
    <div style="flex:1; padding:48px 0; display:flex; justify-content:center; overflow-y: auto;">
        <div style="width:880px; display:flex; flex-direction:column; gap:24px">
            
            @if (CurrentStep == 1)
            {
                <!-- STEP 1: Domain Pack -->
                <div style="font-size:40px; font-weight:800; letter-spacing:-1px">Di cosa è il fanta?</div>
                <div style="display:grid; grid-template-columns:repeat(2, minmax(0,1fr)); gap:16px;">
                    @foreach (var pack in DomainPacks)
                    {
                        var isSelected = _state.DomainPackId == pack.Id;
                        var border = isSelected ? "2px solid var(--color-primary)" : "1px solid var(--color-line)";
                        var iconBg = isSelected ? "var(--color-primary)" : "var(--color-surface-2)";
                        var iconFg = isSelected ? "var(--color-on-primary)" : "var(--color-ink)";
                        var icon = pack.Id == "tech-conference" ? "icon-mic" : pack.Id == "generic" ? "icon-sparkles" : "icon-trophy";

                        <div @onclick="() => SelectDomainPack(pack.Id)" style="min-height:76px; border-radius:16px; background:var(--color-surface); border:@border; padding:14px; display:flex; align-items:center; gap:14px; cursor:pointer">
                            <div style="width:48px; height:48px; border-radius:12px; background:@iconBg; color:@iconFg; display:flex; align-items:center; justify-content:center; font-size:24px; flex:none">
                                <i class="@icon"></i>
                            </div>
                            <div style="flex:1">
                                <div style="font-size:16px; font-weight:800">@(pack.Name.TryGetValue("en", out var n) ? n : pack.Id)</div>
                                <div style="font-size:13px; color:var(--color-ink-2)">@(pack.Description.TryGetValue("en", out var d) ? d : "")</div>
                            </div>
                        </div>
                    }
                </div>
                <div style="margin-top:auto; display:flex; justify-content:flex-end">
                    <button @onclick="NextStep" disabled="@string.IsNullOrEmpty(_state.DomainPackId)" style="height:52px; padding:0 24px; border-radius:14px; background:var(--color-primary); color:var(--color-on-primary); font-weight:800; border:none; cursor:pointer">
                        Continua
                    </button>
                </div>
            }
            else if (CurrentStep == 2)
            {
                <!-- STEP 2: Settings (Name, etc.) -->
                <div style="font-size:40px; font-weight:800; letter-spacing:-1px">Impostazioni partita</div>
                
                <EditForm Model="_state" OnValidSubmit="NextStep">
                    <DataAnnotationsValidator />
                    <div style="display:flex; flex-direction:column; gap:16px">
                        <div style="display:flex; flex-direction:column; gap:6px">
                            <label style="font-size:14px; font-weight:700">Nome della partita</label>
                            <InputText @bind-Value="_state.Name" style="height:52px; border-radius:12px; border:2px solid var(--color-primary); padding:0 14px; font-size:16px; width:100%" />
                            <ValidationMessage For="@(() => _state.Name)" style="color:var(--color-danger); font-size:13px;" />
                        </div>
                        
                        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px">
                            <div style="display:flex; flex-direction:column; gap:6px">
                                <label style="font-size:14px; font-weight:700">Lingua</label>
                                <InputSelect @bind-Value="_state.Culture" style="height:52px; border-radius:12px; border:1px solid var(--color-line); padding:0 14px; font-size:16px; width:100%">
                                    <option value="en">English</option>
                                    <option value="it">Italiano</option>
                                </InputSelect>
                            </div>
                            <div style="display:flex; flex-direction:column; gap:6px">
                                <label style="font-size:14px; font-weight:700">Elementi per rosa (Lineup size)</label>
                                <InputNumber @bind-Value="_state.LineupSize" style="height:52px; border-radius:12px; border:1px solid var(--color-line); padding:0 14px; font-size:16px; width:100%" />
                            </div>
                        </div>

                        <div style="display:flex; align-items:center; gap:12px; margin-top:10px">
                            <InputCheckbox @bind-Value="_state.CaptainEnabled" id="capt" />
                            <label for="capt" style="font-size:15px; font-weight:700">Abilita capitano (i suoi punti valgono doppio)</label>
                        </div>
                    </div>

                    <div style="margin-top:40px; display:flex; justify-content:space-between">
                        <button type="button" @onclick="PrevStep" style="height:52px; padding:0 20px; border-radius:14px; border:1.5px solid var(--color-line-strong); background:transparent; font-weight:700; cursor:pointer">Indietro</button>
                        <button type="submit" style="height:52px; padding:0 24px; border-radius:14px; background:var(--color-primary); color:var(--color-on-primary); font-weight:800; border:none; cursor:pointer">Continua</button>
                    </div>
                </EditForm>
            }
            else if (CurrentStep == 3)
            {
                <!-- STEP 3: Source -->
                <div style="font-size:40px; font-weight:800; letter-spacing:-1px">Da dove prendiamo gli elementi?</div>
                <div style="font-size:17px; color:var(--color-ink-2)">Puoi cambiare sorgente fino alla pubblicazione.</div>
                
                <div style="display:grid; grid-template-columns:repeat(3, minmax(0,1fr)); gap:16px">
                    <div @onclick="@(() => _state.SourceType = "sessionize")" style="border-radius:16px; border:@(_state.SourceType == "sessionize" ? "2px solid var(--color-primary)" : "1px solid var(--color-line)"); background:@(_state.SourceType == "sessionize" ? "var(--color-primary-tint)" : "var(--color-surface)"); padding:20px; display:flex; flex-direction:column; gap:10px; cursor:pointer">
                        <div style="display:flex; justify-content:space-between">
                            <i class="icon-calendar-range" style="font-size:28px; color:var(--color-link)"></i>
                            @if(_state.SourceType == "sessionize") { <span style="width:24px; height:24px; border-radius:50%; background:var(--color-primary); color:var(--color-on-primary); display:flex; align-items:center; justify-content:center; font-size:14px"><i class="icon-check"></i></span> }
                        </div>
                        <div style="font-size:18px; font-weight:800">Sessionize</div>
                        <div style="font-size:14px; color:var(--color-ink-2)">Speaker e sessioni dall'API del tuo evento.</div>
                    </div>
                    
                    <div @onclick="@(() => _state.SourceType = "csv")" style="border-radius:16px; border:@(_state.SourceType == "csv" ? "2px solid var(--color-primary)" : "1px solid var(--color-line)"); background:@(_state.SourceType == "csv" ? "var(--color-primary-tint)" : "var(--color-surface)"); padding:20px; display:flex; flex-direction:column; gap:10px; cursor:pointer">
                        <div style="display:flex; justify-content:space-between">
                            <i class="icon-file-spreadsheet" style="font-size:28px; color:var(--color-link)"></i>
                            @if(_state.SourceType == "csv") { <span style="width:24px; height:24px; border-radius:50%; background:var(--color-primary); color:var(--color-on-primary); display:flex; align-items:center; justify-content:center; font-size:14px"><i class="icon-check"></i></span> }
                        </div>
                        <div style="font-size:18px; font-weight:800">CSV</div>
                        <div style="font-size:14px; color:var(--color-ink-2)">Una riga per elemento (non ancora supportato nel wizard interamente).</div>
                    </div>

                    <div @onclick="@(() => _state.SourceType = "manual")" style="border-radius:16px; border:@(_state.SourceType == "manual" ? "2px solid var(--color-primary)" : "1px solid var(--color-line)"); background:@(_state.SourceType == "manual" ? "var(--color-primary-tint)" : "var(--color-surface)"); padding:20px; display:flex; flex-direction:column; gap:10px; cursor:pointer">
                        <div style="display:flex; justify-content:space-between">
                            <i class="icon-pencil-line" style="font-size:28px; color:var(--color-link)"></i>
                            @if(_state.SourceType == "manual") { <span style="width:24px; height:24px; border-radius:50%; background:var(--color-primary); color:var(--color-on-primary); display:flex; align-items:center; justify-content:center; font-size:14px"><i class="icon-check"></i></span> }
                        </div>
                        <div style="font-size:18px; font-weight:800">Nessuna</div>
                        <div style="font-size:14px; color:var(--color-ink-2)">Aggiungerai elementi a mano in seguito.</div>
                    </div>
                </div>

                @if (_state.SourceType == "sessionize")
                {
                    <div style="display:flex; flex-direction:column; gap:6px; margin-top:16px">
                        <div style="font-size:14px; font-weight:700">ID API Sessionize</div>
                        <input type="text" @bind="_state.SessionizeApiId" style="height:52px; border-radius:12px; border:2px solid var(--color-primary); background:var(--color-surface); padding:0 14px; display:flex; align-items:center; font-size:16px; font-family:ui-monospace,monospace" placeholder="e.g. k3x9vq2m" />
                        @if (!string.IsNullOrEmpty(SourceTestResult))
                        {
                            <div style="font-size:13px; color:var(--color-success); font-weight:700; display:flex; gap:6px; align-items:center">
                                <i class="icon-check"></i>@SourceTestResult
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(SourceTestError))
                        {
                            <div style="font-size:13px; color:var(--color-danger); font-weight:700; display:flex; gap:6px; align-items:center">
                                <i class="icon-x"></i>@SourceTestError
                            </div>
                        }
                    </div>
                }

                <div style="margin-top:auto; display:flex; justify-content:space-between">
                    <button @onclick="PrevStep" style="height:52px; padding:0 20px; border-radius:14px; border:1.5px solid var(--color-line-strong); background:transparent; font-weight:700; cursor:pointer">Indietro</button>
                    <button @onclick="ValidateSourceAndNext" style="height:52px; padding:0 24px; border-radius:14px; background:var(--color-primary); color:var(--color-on-primary); font-weight:800; border:none; cursor:pointer">Importa e continua</button>
                </div>
            }
            else if (CurrentStep == 4)
            {
                <!-- STEP 4: Review Elements (Mocked up, skipping preview details to save code lines) -->
                <div style="font-size:40px; font-weight:800; letter-spacing:-1px">Controlla chi entra in gioco</div>
                <div style="font-size:16px; color:var(--color-ink-2); margin-top:6px">@PreviewElements.Count elementi trovati. Invieremo una richiesta di consenso in seguito.</div>
                
                <div style="border:1px solid var(--color-line); border-radius:14px; overflow:hidden; background:var(--color-surface); max-height: 400px; overflow-y:auto;">
                    <div style="display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1.6fr) 150px; gap:14px; padding:12px 16px; background:var(--color-surface-2); font-size:13px; font-weight:700; color:var(--color-ink-2)">
                        <div>Nome</div><div>Sottotitolo</div><div>Gruppo</div>
                    </div>
                    @foreach (var el in PreviewElements)
                    {
                        <div style="display:grid; grid-template-columns:minmax(0,1.2fr) minmax(0,1.6fr) 150px; gap:14px; padding:10px 16px; border-top:1px solid var(--color-line); align-items:center; font-size:15px">
                            <div style="font-weight:700">@el.Name</div>
                            <div style="color:var(--color-ink-2); white-space:nowrap; overflow:hidden; text-overflow:ellipsis">@el.Subtitle</div>
                            <div>@el.Group</div>
                        </div>
                    }
                </div>

                <div style="margin-top:auto; display:flex; justify-content:space-between">
                    <button @onclick="PrevStep" style="height:52px; padding:0 20px; border-radius:14px; border:1.5px solid var(--color-line-strong); background:transparent; font-weight:700; cursor:pointer">Indietro</button>
                    <button @onclick="NextStep" style="height:52px; padding:0 24px; border-radius:14px; background:var(--color-primary); color:var(--color-on-primary); font-weight:800; border:none; cursor:pointer">Continua</button>
                </div>
            }
            else if (CurrentStep == 5)
            {
                <!-- STEP 5: Rules -->
                <div style="font-size:40px; font-weight:800; letter-spacing:-1px">Regole e punteggi</div>
                <div style="font-size:16px; color:var(--color-ink-2); margin-top:6px">Queste sono le regole di base. Potrai aggiungerne altre in seguito.</div>

                <div style="display:flex; flex-direction:column; gap:10px;">
                    @foreach (var rule in PreviewRules)
                    {
                        var isMalus = rule.Points < 0;
                        var bg = isMalus ? "var(--color-danger-bg)" : "var(--color-lime)";
                        var fg = isMalus ? "var(--color-danger)" : "var(--color-on-lime)";
                        
                        <div style="display:flex; gap:14px; align-items:center; padding:14px 16px; border-radius:12px; background:var(--color-surface); border:1px solid var(--color-line)">
                            <div style="font-size:15px; font-weight:700; flex:1">@(rule.Label.TryGetValue(_state.Culture, out var l) ? l : rule.Label.Values.FirstOrDefault())</div>
                            <div style="height:30px; border-radius:8px; background:@bg; color:@fg; display:flex; align-items:center; justify-content:center; font-size:15px; font-weight:800; padding:0 12px">
                                @(rule.Points > 0 ? "+" : "")@rule.Points
                            </div>
                        </div>
                    }
                </div>

                <div style="margin-top:auto; display:flex; justify-content:space-between">
                    <button @onclick="PrevStep" style="height:52px; padding:0 20px; border-radius:14px; border:1.5px solid var(--color-line-strong); background:transparent; font-weight:700; cursor:pointer">Indietro</button>
                    <button @onclick="NextStep" style="height:52px; padding:0 24px; border-radius:14px; background:var(--color-primary); color:var(--color-on-primary); font-weight:800; border:none; cursor:pointer">Continua</button>
                </div>
            }
            else if (CurrentStep == 6)
            {
                <!-- STEP 6: Publish -->
                <div style="font-size:40px; font-weight:800; letter-spacing:-1px">Tutto pronto</div>
                <div style="font-size:16px; color:var(--color-ink-2); margin-top:6px">Crea la partita per iniziare.</div>

                @if (!string.IsNullOrEmpty(CreationError))
                {
                    <div style="padding:14px; border-radius:12px; background:var(--color-danger-bg); color:var(--color-danger); font-weight:700;">
                        @CreationError
                    </div>
                }

                <div style="margin-top:auto; display:flex; justify-content:space-between">
                    <button @onclick="PrevStep" disabled="@IsSubmitting" style="height:52px; padding:0 20px; border-radius:14px; border:1.5px solid var(--color-line-strong); background:transparent; font-weight:700; cursor:pointer">Indietro</button>
                    <button @onclick="Publish" disabled="@IsSubmitting" style="height:52px; padding:0 24px; border-radius:14px; background:var(--color-primary); color:var(--color-on-primary); font-weight:800; border:none; cursor:pointer">
                        @(IsSubmitting ? "Creazione in corso..." : "Pubblica Partita")
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int CurrentStep = 1;
    private GameWizardState _state = new();
    private IReadOnlyList<DomainPack> DomainPacks = Array.Empty<DomainPack>();
    
    private string? SourceTestResult;
    private string? SourceTestError;
    private List<ImportedElement> PreviewElements = new();
    private List<PackRule> PreviewRules = new();

    private bool IsSubmitting = false;
    private string? CreationError;

    private readonly (int Number, string Label)[] Steps = 
    {
        (1, "Ambito"), (2, "Impostazioni"), (3, "Sorgente"), (4, "Elementi"), (5, "Regole"), (6, "Pubblica")
    };

    protected override void OnInitialized()
    {
        DomainPacks = DomainPackLoader.GetAllPacks();
    }

    private void SelectDomainPack(string id)
    {
        _state.DomainPackId = id;
    }

    private void NextStep()
    {
        if (CurrentStep == 1 && string.IsNullOrEmpty(_state.DomainPackId)) return;
        
        if (CurrentStep == 4)
        {
            var pack = DomainPackLoader.GetPack(_state.DomainPackId);
            if (pack != null)
            {
                PreviewRules = pack.DefaultRules.ToList();
            }
        }

        if (CurrentStep < 6) CurrentStep++;
    }

    private void PrevStep()
    {
        if (CurrentStep > 1) CurrentStep--;
    }

    private async Task ValidateSourceAndNext()
    {
        SourceTestError = null;
        SourceTestResult = null;

        if (_state.SourceType == "sessionize" && !string.IsNullOrEmpty(_state.SessionizeApiId))
        {
            try
            {
                var plugin = PluginRegistry.GetPlugin("sessionize");
                if (plugin != null)
                {
                    var config = new PluginConfig(new Dictionary<string, string> { { "EndpointId", _state.SessionizeApiId } });
                    var result = await plugin.ImportAsync(config, default);
                    PreviewElements = result.Elements.ToList();
                    SourceTestResult = $"Trovati {PreviewElements.Count} elementi";
                    NextStep();
                }
            }
            catch (Exception ex)
            {
                SourceTestError = "Errore durante l'importazione: " + ex.Message;
            }
        }
        else if (_state.SourceType == "manual")
        {
            PreviewElements.Clear();
            NextStep();
        }
        else 
        {
            // CSV skip for now or display error
            SourceTestError = "CSV preview is not implemented in this mockup.";
        }
    }

    private async Task Publish()
    {
        if (IsSubmitting) return;
        IsSubmitting = true;
        CreationError = null;

        try
        {
            string? pluginId = null;
            Dictionary<string, string>? pluginConfig = null;

            if (_state.SourceType == "sessionize" && !string.IsNullOrEmpty(_state.SessionizeApiId))
            {
                pluginId = "sessionize";
                pluginConfig = new Dictionary<string, string> { { "EndpointId", _state.SessionizeApiId } };
            }

            var cmd = new CreateGameCommand(
                Name: _state.Name,
                DomainPackId: _state.DomainPackId,
                Brand: "FantaRoster", // Hardcoded brand context? Actually, `BrandOptions` should provide this, but wait. AGENTS.md rule 4 says "No brand in code. Brand values come from BrandOptions." Let's just pass "fantaroster" for now, or maybe omit it if not needed. But we must provide it. Wait, maybe read from BrandOptions?
                Culture: _state.Culture,
                LineupSize: _state.LineupSize,
                CaptainEnabled: _state.CaptainEnabled,
                CaptainMultiplier: _state.CaptainMultiplier,
                PluginId: pluginId,
                PluginConfig: pluginConfig
            );

            // Wait, BrandOptions doesn't exist here. Let's use string.Empty for now and fix later if needed.
            var cmdToSend = cmd with { Brand = "default" };

            var newGameId = await GameCreationService.CreateGameAsync(cmdToSend, default);
            
            // Redirect to dashboard or game view
            Navigation.NavigateTo("/organizer");
        }
        catch (Exception ex)
        {
            CreationError = ex.Message;
            IsSubmitting = false;
        }
    }
}
