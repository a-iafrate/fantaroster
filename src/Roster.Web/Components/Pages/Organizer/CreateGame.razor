@page "/organizer/create-game"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Roster.Application.Ports
@using Roster.DomainPacks
@using Roster.Plugins.Abstractions
@using Roster.Web.Components.Pages.Organizer
@using Roster.Web.Options
@attribute [Authorize]
@inject IDomainPackLoader DomainPackLoader
@inject IGameCreationService GameCreationService
@inject IPluginRegistry PluginRegistry
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResource> Loc
@inject IOptions<BrandOptions> BrandOptions
@rendermode InteractiveServer
@layout Roster.Web.Components.Layout.EmptyLayout

<PageTitle>@Loc["CreateGameTitle"]</PageTitle>

<div class="create-game-container">
    <!-- Header / Stepper -->
    <div class="cg-header">
        <a href="/organizer" class="cg-close"><i class="icon-x"></i></a>
        <div class="cg-title">@Loc["CreateGameTitle"]</div>
        <div class="cg-stepper">
            @foreach (var step in Steps)
            {
                var isDone = step.Number < CurrentStep;
                var isCurrent = step.Number == CurrentStep;
                
                <div class="cg-step @(isDone ? "done" : "") @(isCurrent ? "current" : "")">
                    <span class="cg-step-num">
                        @(isDone ? "✓" : step.Number.ToString())
                    </span>
                    @step.Label
                    @if (step.Number < Steps.Length)
                    {
                        <span class="cg-step-line"></span>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="cg-main">
        <div class="cg-content">
            
            @if (CurrentStep == 1)
            {
                <!-- STEP 1: Domain Pack -->
                <div class="cg-step-title">@Loc["CreateGameStep1Title"]</div>
                <div class="cg-grid-2">
                    @foreach (var pack in DomainPacks)
                    {
                        var isSelected = _state.DomainPackId == pack.Id;
                        var icon = pack.Id == "tech-conference" ? "icon-mic" : pack.Id == "generic" ? "icon-sparkles" : "icon-trophy";

                        <div @onclick="() => SelectDomainPack(pack.Id)" class="cg-pack-card @(isSelected ? "selected" : "")">
                            <div class="cg-pack-icon">
                                <i class="@icon"></i>
                            </div>
                            <div style="flex:1">
                                <div class="cg-pack-name">@(pack.Name.TryGetValue(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, out var n) || pack.Name.TryGetValue("en", out n) ? n : pack.Id)</div>
                                <div class="cg-pack-desc">@(pack.Description.TryGetValue(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, out var d) || pack.Description.TryGetValue("en", out d) ? d : "")</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="cg-bottom-nav right cg-mt-auto">
                    <button @onclick="NextStep" disabled="@string.IsNullOrEmpty(_state.DomainPackId)" class="cg-btn-primary">
                        @Loc["BtnContinue"]
                    </button>
                </div>
            }
            else if (CurrentStep == 2)
            {
                <!-- STEP 2: Settings (Name, etc.) -->
                <div class="cg-step-title">@Loc["CreateGameStep2Title"]</div>
                
                <EditForm Model="_state" OnValidSubmit="NextStep">
                    <DataAnnotationsValidator />
                    <div class="cg-flex-col-16">
                        <div class="cg-form-group">
                            <label class="cg-label">@Loc["CreateGameNameLabel"]</label>
                            <InputText @bind-Value="_state.Name" class="cg-input" />
                            @if (context.GetValidationMessages(() => _state.Name).Any())
                            {
                                <div class="cg-validation-msg">@Loc[context.GetValidationMessages(() => _state.Name).First()]</div>
                            }
                        </div>
                        
                        <div class="cg-grid-2">
                            <div class="cg-form-group">
                                <label class="cg-label">@Loc["CreateGameLanguageLabel"]</label>
                                <InputSelect @bind-Value="_state.Culture" class="cg-input">
                                    <option value="en">@Loc["LangEnglish"]</option>
                                    <option value="it">@Loc["LangItalian"]</option>
                                </InputSelect>
                            </div>
                            <div class="cg-form-group">
                                <label class="cg-label">@Loc["CreateGameLineupSizeLabel"]</label>
                                <InputNumber @bind-Value="_state.LineupSize" class="cg-input" />
                            </div>
                        </div>

                        <div class="cg-checkbox-group">
                            <InputCheckbox @bind-Value="_state.CaptainEnabled" id="capt" class="cg-checkbox" />
                            <label for="capt" class="cg-checkbox-label">@Loc["CreateGameCaptainLabel"]</label>
                        </div>
                        
                        @if (_state.CaptainEnabled)
                        {
                            <div class="cg-form-group cg-mt-16">
                                <label class="cg-label">@Loc["CreateGameCaptainMultiplierLabel"]</label>
                                <InputNumber @bind-Value="_state.CaptainMultiplier" class="cg-input" step="0.5" />
                            </div>
                        }
                    </div>

                    <div class="cg-bottom-nav cg-mt-40">
                        <button type="button" @onclick="PrevStep" class="cg-btn-secondary">@Loc["BtnBack"]</button>
                        <button type="submit" class="cg-btn-primary">@Loc["BtnContinue"]</button>
                    </div>
                </EditForm>
            }
            else if (CurrentStep == 3)
            {
                <!-- STEP 3: Source -->
                <div class="cg-step-title">@Loc["CreateGameStep3Title"]</div>
                <div class="cg-step-desc">@Loc["CreateGameSourceDesc"]</div>
                
                <div class="cg-grid-3">
                    <div @onclick="@(() => _state.SourceType = "sessionize")" class="cg-source-card @(_state.SourceType == "sessionize" ? "selected" : "")">
                        <div class="cg-source-header">
                            <i class="icon-calendar-range cg-source-icon"></i>
                            @if(_state.SourceType == "sessionize") { <span class="cg-source-check"><i class="icon-check"></i></span> }
                        </div>
                        <div class="cg-source-name">@Loc["SourceSessionize"]</div>
                        <div class="cg-source-desc">@Loc["SourceSessionizeDesc"]</div>
                    </div>
                    
                    <div @onclick="@(() => _state.SourceType = "csv")" class="cg-source-card @(_state.SourceType == "csv" ? "selected" : "")">
                        <div class="cg-source-header">
                            <i class="icon-file-spreadsheet cg-source-icon"></i>
                            @if(_state.SourceType == "csv") { <span class="cg-source-check"><i class="icon-check"></i></span> }
                        </div>
                        <div class="cg-source-name">@Loc["SourceCSV"]</div>
                        <div class="cg-source-desc">@Loc["SourceCSVDesc"]</div>
                    </div>

                    <div @onclick="@(() => _state.SourceType = "manual")" class="cg-source-card @(_state.SourceType == "manual" ? "selected" : "")">
                        <div class="cg-source-header">
                            <i class="icon-pencil-line cg-source-icon"></i>
                            @if(_state.SourceType == "manual") { <span class="cg-source-check"><i class="icon-check"></i></span> }
                        </div>
                        <div class="cg-source-name">@Loc["SourceNone"]</div>
                        <div class="cg-source-desc">@Loc["SourceNoneDesc"]</div>
                    </div>
                </div>

                @if (_state.SourceType == "sessionize")
                {
                    <div class="cg-form-group cg-mt-16">
                        <div class="cg-label">@Loc["SessionizeApiId"]</div>
                        <input type="text" @bind="_state.SessionizeApiId" class="cg-input cg-input-code" placeholder="@Loc["SessionizePlaceholder"]" />
                        @if (!string.IsNullOrEmpty(SourceTestResult))
                        {
                            <div class="cg-alert-success"><i class="icon-check"></i>@SourceTestResult</div>
                        }
                        @if (!string.IsNullOrEmpty(SourceTestError))
                        {
                            <div class="cg-alert-error"><i class="icon-x"></i>@SourceTestError</div>
                        }
                    </div>
                }

                <div class="cg-bottom-nav cg-mt-auto">
                    <button @onclick="PrevStep" class="cg-btn-secondary">@Loc["BtnBack"]</button>
                    <button @onclick="ValidateSourceAndNext" class="cg-btn-primary">@Loc["ImportAndContinue"]</button>
                </div>
            }
            else if (CurrentStep == 4)
            {
                <!-- STEP 4: Review Elements -->
                <div class="cg-step-title">@Loc["CreateGameStep4Title"]</div>
                <div class="cg-step-desc cg-mt-6">@Loc["PreviewElementsCount", PreviewElements.Count]</div>
                
                <div class="cg-list-container">
                    <div class="cg-list-header">
                        <div>@Loc["ColName"]</div><div>@Loc["ColSubtitle"]</div><div>@Loc["ColGroup"]</div>
                    </div>
                    @foreach (var el in PreviewElements)
                    {
                        <div class="cg-list-row">
                            <div class="cg-list-col-bold">@el.Name</div>
                            <div class="cg-list-col-muted">@el.Subtitle</div>
                            <div>@el.Group</div>
                        </div>
                    }
                </div>

                <div class="cg-bottom-nav cg-mt-auto">
                    <button @onclick="PrevStep" class="cg-btn-secondary">@Loc["BtnBack"]</button>
                    <button @onclick="NextStep" class="cg-btn-primary">@Loc["BtnContinue"]</button>
                </div>
            }
            else if (CurrentStep == 5)
            {
                <!-- STEP 5: Rules -->
                <div class="cg-step-title">@Loc["CreateGameStep5Title"]</div>
                <div class="cg-step-desc cg-mt-6">@Loc["CreateGameRulesDesc"]</div>

                <div class="cg-flex-col-10">
                    @foreach (var rule in PreviewRules)
                    {
                        var isMalus = rule.Points < 0;
                        
                        <div class="cg-rule-card">
                            <div class="cg-rule-label">@(rule.Label.TryGetValue(_state.Culture, out var l) ? l : rule.Label.Values.FirstOrDefault())</div>
                            <div class="cg-rule-badge @(isMalus ? "malus" : "bonus")">
                                @(rule.Points > 0 ? "+" : "")@rule.Points
                            </div>
                        </div>
                    }
                </div>

                <div class="cg-bottom-nav cg-mt-auto">
                    <button @onclick="PrevStep" class="cg-btn-secondary">@Loc["BtnBack"]</button>
                    <button @onclick="NextStep" class="cg-btn-primary">@Loc["BtnContinue"]</button>
                </div>
            }
            else if (CurrentStep == 6)
            {
                <!-- STEP 6: Publish -->
                <div class="cg-step-title">@Loc["CreateGameStep6Title"]</div>
                <div class="cg-step-desc cg-mt-6">@Loc["CreateGamePublishDesc"]</div>

                @if (!string.IsNullOrEmpty(CreationError))
                {
                    <div class="cg-error-box">
                        @CreationError
                    </div>
                }

                <div class="cg-bottom-nav cg-mt-auto">
                    <button @onclick="PrevStep" disabled="@IsSubmitting" class="cg-btn-secondary">@Loc["BtnBack"]</button>
                    <button @onclick="Publish" disabled="@IsSubmitting" class="cg-btn-primary">
                        @(IsSubmitting ? Loc["Loading"] : Loc["BtnPublish"])
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private int CurrentStep = 1;
    private GameWizardState _state = new();
    private IReadOnlyList<DomainPack> DomainPacks = Array.Empty<DomainPack>();
    
    private string? SourceTestResult;
    private string? SourceTestError;
    private List<ImportedElement> PreviewElements = new();
    private List<PackRule> PreviewRules = new();

    private bool IsSubmitting = false;
    private string? CreationError;

    private (int Number, string Label)[] Steps => new[]
    {
        (1, Loc["StepScope"].ToString()), 
        (2, Loc["StepSettings"].ToString()), 
        (3, Loc["StepSource"].ToString()), 
        (4, Loc["StepElements"].ToString()), 
        (5, Loc["StepRules"].ToString()), 
        (6, Loc["StepPublish"].ToString())
    };

    protected override void OnInitialized()
    {
        DomainPacks = DomainPackLoader.GetAllPacks();
    }

    private void SelectDomainPack(string id)
    {
        _state.DomainPackId = id;
    }

    private void NextStep()
    {
        if (CurrentStep == 1 && string.IsNullOrEmpty(_state.DomainPackId)) return;
        
        if (CurrentStep == 4)
        {
            var pack = DomainPackLoader.GetPack(_state.DomainPackId);
            if (pack != null)
            {
                PreviewRules = pack.DefaultRules.ToList();
            }
        }

        if (CurrentStep < 6) CurrentStep++;
    }

    private void PrevStep()
    {
        if (CurrentStep > 1) CurrentStep--;
    }

    private async Task ValidateSourceAndNext()
    {
        SourceTestError = null;
        SourceTestResult = null;

        if (_state.SourceType == "sessionize" && !string.IsNullOrEmpty(_state.SessionizeApiId))
        {
            try
            {
                var plugin = PluginRegistry.GetPlugin("sessionize");
                if (plugin != null)
                {
                    var config = new PluginConfig(new Dictionary<string, string> { { "EndpointId", _state.SessionizeApiId } });
                    var result = await plugin.ImportAsync(config, default);
                    PreviewElements = result.Elements.ToList();
                    SourceTestResult = Loc["SessionizeFound", PreviewElements.Count];
                    NextStep();
                }
            }
            catch (Exception ex)
            {
                SourceTestError = Loc["SessionizeError", ex.Message];
            }
        }
        else if (_state.SourceType == "manual")
        {
            PreviewElements.Clear();
            NextStep();
        }
        else 
        {
            SourceTestError = Loc["SessionizeCsvError"];
        }
    }

    private async Task Publish()
    {
        if (IsSubmitting) return;
        IsSubmitting = true;
        CreationError = null;

        try
        {
            string? pluginId = null;
            Dictionary<string, string>? pluginConfig = null;

            if (_state.SourceType == "sessionize" && !string.IsNullOrEmpty(_state.SessionizeApiId))
            {
                pluginId = "sessionize";
                pluginConfig = new Dictionary<string, string> { { "EndpointId", _state.SessionizeApiId } };
            }

            var cmd = new CreateGameCommand(
                Name: _state.Name,
                DomainPackId: _state.DomainPackId,
                Brand: BrandOptions.Value.Id,
                Culture: _state.Culture,
                LineupSize: _state.LineupSize,
                CaptainEnabled: _state.CaptainEnabled,
                CaptainMultiplier: _state.CaptainMultiplier,
                PluginId: pluginId,
                PluginConfig: pluginConfig
            );

            var newGameId = await GameCreationService.CreateGameAsync(cmd, default);
            
            Navigation.NavigateTo("/organizer");
        }
        catch (Exception ex)
        {
            CreationError = Loc["CreateGameError", ex.Message];
            IsSubmitting = false;
        }
    }
}
