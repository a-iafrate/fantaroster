@using Roster.Application.Services
@using Roster.Domain.Referees
@inject RefereeManagementService RefereeService
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="ds-page">
    <header class="ds-page-header">
        <div class="ds-page-heading">
            <h1 class="ds-page-title">@Loc["NavReferees"]</h1>
            <p class="ds-page-desc">@Loc["RefereesDesc"]</p>
        </div>
        <div class="ds-page-actions">
            <button type="button" class="ds-btn ds-btn--primary" @onclick="OpenAddReferee"><i class="icon-send" aria-hidden="true"></i>@Loc["BtnAddReferee"]</button>
        </div>
    </header>

    @if (Referees is null)
    {
        <p class="ds-muted" role="status">@Loc["Loading"]</p>
    }
    else if (Referees.Count == 0)
    {
        <p class="ds-muted" role="status">@Loc["NoReferees"]</p>
    }
    else
    {
        <ul class="ds-rows ref-rows">
            <li class="ds-row ds-row--head" aria-hidden="true"><span>@Loc["ColDisplayName"]</span><span></span></li>
            @foreach (var referee in Referees)
            {
                <li class="ds-row">
                    <div class="ds-row__main"><span class="ds-row__title">@referee.DisplayName</span></div>
                    <div class="ds-row__actions">
                        <button type="button" class="ds-btn ds-btn--danger" aria-label="@string.Format(Loc["DeleteRefereeNamed"], referee.DisplayName)" @onclick="() => DeleteReferee(referee.Id)">
                            <i class="icon-trash-2" aria-hidden="true"></i>@Loc["BtnDelete"]
                        </button>
                    </div>
                </li>
            }
        </ul>
    }
</div>

@if (ShowAddDialog)
{
    <Modal Title="@Loc["AddRefereeTitle"]" CloseLabel="@Loc["BtnClose"]" OnClose="CloseAddDialog">
        <ChildContent>
            @if (NewRefereeToken is not null)
            {
                <p class="ds-muted">@Loc["RefereeLinkSuccess"]</p>
                <div class="ds-link-field">
                    <span aria-label="@Loc["RefereeLinkLabel"]">@InviteLink(NewRefereeToken)</span>
                    <button type="button" class="ds-btn ds-btn--primary" @onclick="() => CopyLinkAsync(NewRefereeToken)"><i class="icon-copy" aria-hidden="true"></i>@(LinkCopied ? Loc["LinkCopied"] : Loc["BtnCopyLink"])</button>
                </div>
                <p class="ds-alert ds-alert--info">@Loc["RefereeLinkWarning"]</p>
            }
            else
            {
                <EditForm id="add-referee-form" Model="NewRefereeModel" OnValidSubmit="HandleValidSubmit" class="ds-form">
                    <DataAnnotationsValidator />
                    <div class="ds-field">
                        <label class="ds-label" for="referee-name">@Loc["ColDisplayName"]</label>
                        <InputText id="referee-name" class="ds-input" @bind-Value="NewRefereeModel.DisplayName" maxlength="80" />
                        <ValidationMessage For="@(() => NewRefereeModel.DisplayName)" />
                    </div>
                </EditForm>
            }
        </ChildContent>
        <Actions>
            @if (NewRefereeToken is not null)
            {
                <button type="button" class="ds-btn ds-btn--secondary" @onclick="CloseAddDialog">@Loc["BtnClose"]</button>
            }
            else
            {
                <button type="button" class="ds-btn ds-btn--secondary" @onclick="CloseAddDialog" disabled="@IsProcessing">@Loc["BtnCancel"]</button>
                <button type="submit" form="add-referee-form" class="ds-btn ds-btn--primary" disabled="@IsProcessing">@Loc["BtnAddReferee"]</button>
            }
        </Actions>
    </Modal>
}

@code {
    [Parameter]
    public Guid GameId { get; set; }

    [Parameter]
    public EventCallback<string> OnError { get; set; }

    private IReadOnlyList<Referee>? Referees;
    private bool ShowAddDialog = false;
    private bool IsProcessing = false;
    private string? NewRefereeToken = null;
    private bool LinkCopied;

    private AddRefereeModel NewRefereeModel = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadRefereesAsync();
    }

    private async Task LoadRefereesAsync()
    {
        try
        {
            Referees = await RefereeService.GetRefereesAsync(GameId);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    // The token travels in the URL fragment: browsers never send it to the server or write it in access logs.
    private string InviteLink(string token) =>
        $"{Navigation.ToAbsoluteUri($"/games/{GameId}/referee").AbsoluteUri}#t={Uri.EscapeDataString(token)}";

    private async Task CopyLinkAsync(string token)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", InviteLink(token));
        LinkCopied = true;
    }

    private void OpenAddReferee()
    {
        NewRefereeModel = new AddRefereeModel();
        NewRefereeToken = null;
        LinkCopied = false;
        ShowAddDialog = true;
    }

    private void CloseAddDialog()
    {
        ShowAddDialog = false;
        NewRefereeToken = null;
    }

    private async Task HandleValidSubmit()
    {
        if (IsProcessing) return;
        IsProcessing = true;
        try
        {
            NewRefereeToken = await RefereeService.CreateRefereeAsync(GameId, NewRefereeModel.DisplayName);
            await LoadRefereesAsync();
            // The dialog stays open: the link is shown only once and must be copied now.
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private async Task DeleteReferee(Guid refereeId)
    {
        try
        {
            await RefereeService.DeleteRefereeAsync(refereeId);
            await LoadRefereesAsync();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    public class AddRefereeModel
    {
        [System.ComponentModel.DataAnnotations.Required]
        public string DisplayName { get; set; } = string.Empty;
    }
}
