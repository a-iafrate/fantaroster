@using Roster.Application.Services
@using Roster.Domain.Games
@inject GameSettingsService SettingsService
@inject IStringLocalizer<SharedResource> Loc

<div class="ds-page">
    <header class="ds-page-header">
        <div class="ds-page-heading">
            <h1 class="ds-page-title">@Loc["NavSettings"]</h1>
            <p class="ds-page-desc">@Loc["SettingsDesc"]</p>
        </div>
    </header>

    @if (_canEdit is null)
    {
        <p class="ds-muted" role="status">@Loc["Loading"]</p>
    }
    else
    {
        @if (_canEdit == false)
        {
            <p class="ds-alert ds-alert--info" role="status">@Loc["SettingsLockedNotice"]</p>
        }

        <form class="ds-form settings-form" @onsubmit="SaveAsync">
            <div class="ds-field">
                <label class="ds-label" for="settings-name">@Loc["CreateGameNameLabel"]</label>
                <input id="settings-name" class="ds-input" @bind="_name" maxlength="100" required />
            </div>
            <div class="ds-field">
                <label class="ds-label" for="settings-size">@Loc["CreateGameLineupSizeLabel"]</label>
                <input id="settings-size" type="number" min="1" inputmode="numeric" class="ds-input" @bind="_lineupSize" disabled="@(_canEdit != true)" />
            </div>

            @if (_saved)
            {
                <p class="ds-alert ds-alert--success" role="status">@Loc["SettingsSaved"]</p>
            }

            <button type="submit" class="ds-btn ds-btn--l ds-btn--primary" disabled="@_isSaving">@Loc["BtnSave"]</button>
        </form>
    }
</div>

@code {
    [Parameter]
    public Game Game { get; set; } = default!;

    [Parameter]
    public EventCallback OnSaved { get; set; }

    [Parameter]
    public EventCallback<string> OnError { get; set; }

    private bool? _canEdit;
    private bool _isSaving;
    private bool _saved;
    private string _name = string.Empty;
    private int _lineupSize;

    protected override async Task OnInitializedAsync()
    {
        _name = Game.Name;
        _lineupSize = Game.LineupSize;

        try
        {
            _canEdit = await SettingsService.CanEditAsync(Game.Id);
        }
        catch (Exception ex)
        {
            _canEdit = false;
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private async Task SaveAsync()
    {
        _saved = false;

        if (string.IsNullOrWhiteSpace(_name) || _lineupSize < 1)
        {
            await OnError.InvokeAsync(Loc["SettingsInvalid"]);
            return;
        }

        _isSaving = true;
        try
        {
            await SettingsService.UpdateAsync(Game.Id, _name, _lineupSize);
            _saved = true;
            await OnError.InvokeAsync(string.Empty);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            _isSaving = false;
        }
    }
}
