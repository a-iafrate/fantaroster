@using Roster.Application.Services
@using Roster.Domain.Games
@using Roster.Web.Client.Components.Participant
@inject RuleManagementService RuleService
@inject IStringLocalizer<SharedResource> Loc

<div class="ds-page">
    <header class="ds-page-header">
        <div class="ds-page-heading">
            <h1 class="ds-page-title">@Loc["NavRules"]</h1>
            <p class="ds-page-desc">@Loc["RuleEditorDesc"]</p>
        </div>
        @if (CanEdit)
        {
            <div class="ds-page-actions">
                <button type="button" class="ds-btn ds-btn--primary" @onclick="AddNewRule"><i class="icon-plus" aria-hidden="true"></i>@Loc["BtnAddRule"]</button>
            </div>
        }
    </header>

    <p class="ds-alert ds-alert--info"><i class="icon-info" aria-hidden="true"></i> @Loc["RulesEthicsNote"]</p>

    @if (!CanEdit)
    {
        <p class="ds-alert ds-alert--info" role="status">@Loc["RuleEditorDisabledInfo"]</p>
    }

    @if (Rules is null)
    {
        <p class="ds-muted" role="status">@Loc["Loading"]</p>
    }
    else if (Rules.Count == 0)
    {
        <p class="ds-muted" role="status">@Loc["NoRules"]</p>
    }
    else
    {
        <ul class="ds-rows rule-rows">
            <li class="ds-row ds-row--head" aria-hidden="true">
                <span>@Loc["ColLabel"]</span><span>@Loc["ColTarget"]</span><span>@Loc["ColPoints"]</span><span></span>
            </li>
            @for (var i = 0; i < Rules.Count; i++)
            {
                var rule = Rules[i];
                var index = i;
                <li class="ds-row">
                    <div class="ds-row__main">
                        <span class="ds-row__title">@rule.Label</span>
                        @if (!string.IsNullOrWhiteSpace(rule.Category))
                        {
                            <span class="ds-row__sub">@rule.Category</span>
                        }
                    </div>
                    <span class="ds-row__cell">@(rule.Target == RuleTarget.Element ? Loc["TargetElement"] : Loc["TargetParticipant"])</span>
                    <span class="ds-points @(rule.Points < 0 ? "ds-points--penalty" : "")">@ParticipantFormat.Points(rule.Points)</span>
                    @if (CanEdit)
                    {
                        <div class="ds-row__actions">
                            <button type="button" class="ds-icon-btn" disabled="@(index == 0)" aria-label="@string.Format(Loc["MoveUpRule"], rule.Label)" @onclick="() => MoveRuleUp(rule)"><i class="icon-arrow-up" aria-hidden="true"></i></button>
                            <button type="button" class="ds-icon-btn" disabled="@(index == Rules.Count - 1)" aria-label="@string.Format(Loc["MoveDownRule"], rule.Label)" @onclick="() => MoveRuleDown(rule)"><i class="icon-arrow-down" aria-hidden="true"></i></button>
                            <button type="button" class="ds-icon-btn" aria-label="@string.Format(Loc["EditRuleNamed"], rule.Label)" @onclick="() => EditRule(rule)"><i class="icon-pencil-line" aria-hidden="true"></i></button>
                        </div>
                    }
                </li>
            }
        </ul>
    }
</div>

@if (EditingRule is not null || IsAdding)
{
    <Modal Title="@(IsAdding ? Loc["AddRuleTitle"] : Loc["EditRuleTitle"])" CloseLabel="@Loc["BtnCancel"]" OnClose="CancelEdit">
        <ChildContent>
            <div class="ds-form">
                <div class="ds-field">
                    <label class="ds-label" for="rule-label">@Loc["RuleWhatHappens"]</label>
                    <input id="rule-label" type="text" class="ds-input" @bind="EditLabel" @bind:event="oninput" maxlength="120" />
                </div>

                <div class="ds-segmented" role="group" aria-label="@Loc["ColPoints"]">
                    <button type="button" aria-pressed="@(EditPoints > 0 ? "true" : "false")" @onclick="() => SetBonus(true)"><i class="icon-plus" aria-hidden="true"></i> @Loc["RuleBonus"]</button>
                    <button type="button" aria-pressed="@(EditPoints < 0 ? "true" : "false")" @onclick="() => SetBonus(false)"><i class="icon-minus" aria-hidden="true"></i> @Loc["RuleMalus"]</button>
                </div>

                <div class="rule-points" role="group" aria-label="@Loc["ColPoints"]">
                    <span class="ds-label">@Loc["ColPoints"]</span>
                    <span class="ds-stepper">
                        <button type="button" class="ds-icon-btn" aria-label="@Loc["PointsLess"]" @onclick="() => Step(-1)"><i class="icon-minus" aria-hidden="true"></i></button>
                        <output class="ds-stepper__value" aria-live="polite">@ParticipantFormat.Points(EditPoints)</output>
                        <button type="button" class="ds-icon-btn" aria-label="@Loc["PointsMore"]" @onclick="() => Step(1)"><i class="icon-plus" aria-hidden="true"></i></button>
                    </span>
                </div>

                <div class="ds-field">
                    <label class="ds-label" for="rule-category">@Loc["ColCategory"]</label>
                    <input id="rule-category" type="text" class="ds-input" @bind="EditCategory" maxlength="60" />
                </div>

                @if (IsAdding)
                {
                    <div class="ds-field">
                        <label class="ds-label" for="rule-target">@Loc["ColTarget"]</label>
                        <select id="rule-target" class="ds-select" @bind="EditTarget">
                            <option value="@RuleTarget.Element">@Loc["TargetElement"]</option>
                            <option value="@RuleTarget.Participant">@Loc["TargetParticipant"]</option>
                        </select>
                    </div>
                }
            </div>
        </ChildContent>
        <Actions>
            <button type="button" class="ds-btn ds-btn--secondary" @onclick="CancelEdit">@Loc["BtnCancel"]</button>
            <button type="button" class="ds-btn ds-btn--primary" @onclick="SaveEdit" disabled="@(EditPoints == 0 || string.IsNullOrWhiteSpace(EditLabel))">@Loc["BtnSaveRule"]</button>
            @if (!IsAdding && EditingRule is { } editing)
            {
                <button type="button" class="ds-btn ds-btn--danger" @onclick="() => DeleteRule(editing)">@Loc["BtnDelete"]</button>
            }
        </Actions>
    </Modal>
}

@code {
    private const int MaxPoints = 999;

    [Parameter] public Guid GameId { get; set; }
    [Parameter] public GameState GameState { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private List<Rule>? Rules;

    private bool CanEdit => GameState == GameState.Draft || GameState == GameState.Open;

    private bool IsAdding = false;
    private Rule? EditingRule;

    private string EditLabel = "";
    private int EditPoints = 1;
    private string EditCategory = "";
    private RuleTarget EditTarget = RuleTarget.Element;

    protected override async Task OnInitializedAsync()
    {
        await LoadRules();
    }

    private async Task LoadRules()
    {
        try
        {
            Rules = (await RuleService.GetRulesByGameAsync(GameId)).ToList();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private void AddNewRule()
    {
        IsAdding = true;
        EditingRule = null;
        EditLabel = "";
        EditPoints = 1;
        EditCategory = "";
        EditTarget = RuleTarget.Element;
    }

    private void EditRule(Rule rule)
    {
        IsAdding = false;
        EditingRule = rule;
        EditLabel = rule.Label;
        EditPoints = rule.Points;
        EditCategory = rule.Category;
        EditTarget = rule.Target;
    }

    private void SetBonus(bool bonus) => EditPoints = bonus ? Math.Abs(EditPoints) : -Math.Abs(EditPoints);

    /// <summary>Changes the size of the points, keeping the sign and never reaching zero.</summary>
    private void Step(int delta)
    {
        var sign = EditPoints < 0 ? -1 : 1;
        var size = Math.Clamp(Math.Abs(EditPoints) + delta, 1, MaxPoints);
        EditPoints = sign * size;
    }

    private void CancelEdit()
    {
        IsAdding = false;
        EditingRule = null;
    }

    private async Task SaveEdit()
    {
        if (EditPoints == 0 || string.IsNullOrWhiteSpace(EditLabel)) return;

        try
        {
            if (IsAdding)
            {
                await RuleService.AddRuleAsync(GameId, EditLabel, EditPoints, EditCategory, EditTarget);
            }
            else if (EditingRule != null)
            {
                await RuleService.EditRuleAsync(GameId, EditingRule.Id, EditLabel, EditPoints, EditCategory);
            }

            IsAdding = false;
            EditingRule = null;
            await LoadRules();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private async Task DeleteRule(Rule rule)
    {
        try
        {
            await RuleService.DeleteRuleAsync(GameId, rule.Id);
            CancelEdit();
            await LoadRules();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private async Task MoveRuleUp(Rule rule)
    {
        if (Rules == null) return;
        var index = Rules.IndexOf(rule);
        if (index > 0)
        {
            var prev = Rules[index - 1];
            Rules[index - 1] = rule;
            Rules[index] = prev;

            await SaveOrder();
        }
    }

    private async Task MoveRuleDown(Rule rule)
    {
        if (Rules == null) return;
        var index = Rules.IndexOf(rule);
        if (index < Rules.Count - 1)
        {
            var next = Rules[index + 1];
            Rules[index + 1] = rule;
            Rules[index] = next;

            await SaveOrder();
        }
    }

    private async Task SaveOrder()
    {
        if (Rules == null) return;
        try
        {
            var orderedIds = Rules.Select(r => r.Id).ToList();
            await RuleService.ReorderRulesAsync(GameId, orderedIds);
            await LoadRules();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }
}
