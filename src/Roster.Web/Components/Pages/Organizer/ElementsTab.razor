@using Microsoft.Extensions.Localization
@using Roster.Application.Services
@using Roster.Application.Ports
@using Roster.Application.Ports.Data
@using Roster.Domain.Elements
@using Roster.Domain.Games
@using Roster.Domain.Sources
@inject ElementManagementService ElementService
@inject ISourceBindingRepository SourceBindingRepository
@inject IResyncService ResyncService
@inject IStringLocalizer<SharedResource> Loc

<div class="mg-section">
    <div style="display:flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
        <div>
            <div class="mg-section-title">@Loc["ElementManagementTitle"]</div>
            <div class="mg-section-desc">@Loc["ElementManagementDesc"]</div>
        </div>
        <div>
            @if (SourceBindings != null && SourceBindings.Count > 0)
            {
                <button class="mg-btn-secondary" @onclick="ForceResync" disabled="@IsResyncing">
                    <i class="icon-refresh-cw"></i> @(IsResyncing ? Loc["Loading"] : Loc["BtnResync"])
                </button>
            }
            else if (SourceBindings != null && SourceBindings.Count == 0)
            {
                <button class="mg-btn-primary" @onclick="OpenAddElement">
                    <i class="icon-plus"></i> @Loc["BtnAddElement"]
                </button>
            }
        </div>
    </div>

    @if (Elements == null)
    {
        <div>@Loc["Loading"]</div>
    }
    else
    {
        <div class="cg-list-container">
            <div class="cg-list-header">
                <div>@Loc["ColName"]</div>
                <div>@Loc["ColGroup"]</div>
                <div>@Loc["ColStatus"]</div>
                <div>@Loc["ColActions"]</div>
            </div>
            @foreach (var el in Elements)
            {
                <div class="cg-list-row @(el.IsHidden ? "element-hidden" : "")">
                    <div class="cg-list-col-bold" style="display: flex; align-items: center; gap: 8px;">
                        @if (!string.IsNullOrEmpty(el.ImageUrl))
                        {
                            <img src="@el.ImageUrl" alt="" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-line);" />
                        }
                        <div>
                            @el.Name
                            @if (!string.IsNullOrEmpty(el.Subtitle))
                            {
                                <div class="element-subtitle">@el.Subtitle</div>
                            }
                        </div>
                    </div>
                    <div>@el.Group</div>
                    <div class="element-status-col">
                        <span class="element-badge @(el.IsSelectable ? "badge-success" : "badge-neutral")">
                            @(el.IsSelectable ? Loc["StatusSelectable"] : Loc["StatusNotSelectable"])
                        </span>
                        @if (el.SourceState == SourceState.MissingFromSource)
                        {
                            <span class="element-badge badge-warning">@Loc["StatusMissing"]</span>
                        }
                        <span class="element-badge badge-info">@el.ConsentStatus.ToString()</span>
                    </div>
                    <div class="element-actions">
                        <button class="mg-btn-text" @onclick="() => EditElement(el)">@Loc["BtnEdit"]</button>
                        
                        @if (el.IsHidden)
                        {
                            <button class="mg-btn-text" @onclick="() => ToggleVisibility(el, false)">@Loc["BtnShow"]</button>
                        }
                        else
                        {
                            <button class="mg-btn-text" @onclick="() => ToggleVisibility(el, true)">@Loc["BtnHide"]</button>
                        }

                        @if (el.IsSelectable)
                        {
                            <button class="mg-btn-text" @onclick="() => ToggleSelectability(el, false)">@Loc["BtnMakeNotSelectable"]</button>
                        }
                        else
                        {
                            <button class="mg-btn-text" @onclick="() => ToggleSelectability(el, true)" disabled="@(el.ConsentStatus == ConsentStatus.Declined)">@Loc["BtnMakeSelectable"]</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (EditingElement != null || IsAddingElement)
    {
        <div class="modal-backdrop">
            <div class="modal">
                <div class="modal-title">@(IsAddingElement ? Loc["AddElementTitle"] : Loc["EditElementTitle"])</div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>@Loc["ColName"]</label>
                        <input type="text" @bind="EditName" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>@Loc["ColSubtitle"]</label>
                        <input type="text" @bind="EditSubtitle" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>@Loc["ColGroup"]</label>
                        <input type="text" @bind="EditGroup" class="form-control" />
                    </div>
                    <div class="form-group">
                        <label>@Loc["ColImageUrl"]</label>
                        <input type="text" @bind="EditImageUrl" class="form-control" placeholder="https://..." />
                    </div>
                </div>
                <div class="modal-actions">
                    <button class="mg-btn-secondary" @onclick="CancelEdit">@Loc["BtnCancel"]</button>
                    <button class="mg-btn-primary" @onclick="SaveElement">@Loc["BtnSave"]</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid GameId { get; set; }
    [Parameter] public GameState GameState { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private IReadOnlyList<Element>? Elements;
    private List<SourceBinding>? SourceBindings;
    
    private Element? EditingElement;
    private bool IsAddingElement;
    private bool IsResyncing;
    
    private string EditName = "";
    private string? EditSubtitle;
    private string? EditGroup;
    private string? EditImageUrl;

    protected override async Task OnInitializedAsync()
    {
        SourceBindings = await SourceBindingRepository.GetByGameIdAsync(GameId);
        await LoadElements();
    }

    private async Task LoadElements()
    {
        try
        {
            Elements = await ElementService.GetElementsByGameAsync(GameId);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private void EditElement(Element element)
    {
        IsAddingElement = false;
        EditingElement = element;
        EditName = element.Name;
        EditSubtitle = element.Subtitle;
        EditGroup = element.Group;
        EditImageUrl = element.ImageUrl;
    }

    private void OpenAddElement()
    {
        EditingElement = null;
        IsAddingElement = true;
        EditName = "";
        EditSubtitle = null;
        EditGroup = null;
        EditImageUrl = null;
    }

    private void CancelEdit()
    {
        EditingElement = null;
        IsAddingElement = false;
    }

    private async Task SaveElement()
    {
        if (string.IsNullOrWhiteSpace(EditName)) return;

        try
        {
            if (IsAddingElement)
            {
                await ElementService.AddElementAsync(GameId, EditName, EditSubtitle, EditGroup, EditImageUrl);
            }
            else if (EditingElement != null)
            {
                await ElementService.UpdateElementDetailsAsync(EditingElement.Id, EditName, EditSubtitle, EditGroup, EditImageUrl);
            }
            
            CancelEdit();
            await LoadElements();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private async Task ToggleVisibility(Element element, bool isHidden)
    {
        try
        {
            await ElementService.SetElementVisibilityAsync(element.Id, isHidden);
            await LoadElements();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private async Task ToggleSelectability(Element element, bool isSelectable)
    {
        try
        {
            await ElementService.SetElementSelectabilityAsync(element.Id, isSelectable);
            await LoadElements();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
    }

    private async Task ForceResync()
    {
        if (SourceBindings == null || SourceBindings.Count == 0 || IsResyncing) return;
        
        IsResyncing = true;
        try
        {
            var binding = SourceBindings.First();
            await ResyncService.ResyncGameElementsAsync(GameId, binding.Id, default);
            await LoadElements();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            IsResyncing = false;
        }
    }
}
