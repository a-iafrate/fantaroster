@page "/organizer"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@using Roster.Application.Ports.Data
@using Roster.Domain.Games
@attribute [Authorize]
@inject IGameRepository GameRepository
@inject Roster.Application.Services.GameLifecycleService LifecycleService
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["DashboardTitle"]</PageTitle>

<div class="dashboard-header">
    <div class="dashboard-title">@Loc["DashboardTitle"]</div>
    <a href="/organizer/create-game" class="new-game-btn">
        <i class="icon-plus"></i> @Loc["NewGame"]
    </a>
</div>

<div class="game-filters">
    <div class="filter-chip @(activeFilter == "All" ? "active" : "")" @onclick="@(() => SetFilter("All"))">@Loc["FilterAll"]</div>
    <div class="filter-chip @(activeFilter == "Draft" ? "active" : "")" @onclick="@(() => SetFilter("Draft"))">@Loc["FilterDrafts"]</div>
    <div class="filter-chip @(activeFilter == "Live" ? "active" : "")" @onclick="@(() => SetFilter("Live"))">@Loc["FilterLive"]</div>
    <div class="filter-chip @(activeFilter == "Archived" ? "active" : "")" @onclick="@(() => SetFilter("Archived"))">@Loc["FilterArchived"]</div>
</div>

<div class="games-grid">
    @if (Games == null)
    {
        <div>@Loc["Loading"]</div>
    }
    else
    {
        var filteredGames = Games.Where(g => 
            activeFilter == "All" || 
            (activeFilter == "Draft" && g.State == GameState.Draft) ||
            (activeFilter == "Live" && g.State == GameState.Live) ||
            (activeFilter == "Archived" && g.State == GameState.Archived)
        );

        @foreach (var game in filteredGames)
        {
            var isLive = game.State == GameState.Live;
            var dotColor = isLive ? "var(--color-success)" : "var(--color-ink-2)";
            var actionText = isLive ? Loc["ManageLive"] : Loc["OpenGame"];
            var statusText = Loc["State" + game.State.ToString()];

            <div class="game-card">
                <div class="game-status">
                    <span class="status-dot" style="background: @dotColor"></span>
                    @statusText
                    <div class="game-menu-container">
                        <i class="icon-ellipsis game-menu-icon" @onclick="() => ToggleMenu(game.Id)"></i>
                        @if (activeMenuId == game.Id)
                        {
                            <div class="game-dropdown">
                                <a href="/organizer/games/@game.Id" class="game-dropdown-item">@actionText</a>
                                <button type="button" class="game-dropdown-item game-dropdown-danger" @onclick="() => AskDelete(game)">@Loc["DeleteGameMenu"]</button>
                            </div>
                        }
                    </div>
                </div>
                <div class="game-name">@game.Name</div>
                <div class="game-meta">
                    Pack: @game.DomainPackId
                </div>
                <div class="game-footer">
                    <span>@game.CreatedAt.ToString("MMM yyyy")</span>
                    <a href="/organizer/games/@game.Id" class="game-action">@actionText</a>
                </div>
            </div>
        }
    }

    <div class="duplicate-card">
        <i class="icon-copy"></i>
        <div class="duplicate-title">@Loc["DuplicateTitle"]</div>
        <div class="duplicate-desc">@Loc["DuplicateDesc"]</div>
    </div>
</div>

@if (gameToDelete is not null)
{
    <div class="delete-backdrop" @onclick="CancelDelete">
        <div class="delete-dialog" role="alertdialog" aria-modal="true" aria-labelledby="delete-title" @onclick:stopPropagation>
            <h3 id="delete-title">@Loc["DeleteGameTitle"]</h3>
            <p>@string.Format(Loc["DeleteGameWarning"], gameToDelete.Name)</p>
            @if (!string.IsNullOrEmpty(deleteError))
            {
                <p class="delete-error">@deleteError</p>
            }
            <div class="delete-actions">
                <button type="button" class="delete-cancel" @onclick="CancelDelete" disabled="@isDeleting">@Loc["BtnCancel"]</button>
                <button type="button" class="delete-confirm" @onclick="ConfirmDeleteAsync" disabled="@isDeleting">@Loc["DeleteGameConfirm"]</button>
            </div>
        </div>
    </div>
}

@code {
    private Game? gameToDelete;
    private bool isDeleting;
    private string? deleteError;

    private void AskDelete(Game game)
    {
        activeMenuId = null;
        deleteError = null;
        gameToDelete = game;
    }

    private void CancelDelete()
    {
        if (!isDeleting) gameToDelete = null;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (gameToDelete is null || isDeleting) return;

        isDeleting = true;
        try
        {
            await LifecycleService.DeleteGameAsync(gameToDelete.Id);
            Games = await GameRepository.GetAllAsync();
            gameToDelete = null;
        }
        catch (Exception ex)
        {
            deleteError = ex.Message;
        }
        finally
        {
            isDeleting = false;
        }
    }

    private List<Game>? Games;
    private Guid? activeMenuId;
    private string activeFilter = "All";

    protected override async Task OnInitializedAsync()
    {
        Games = await GameRepository.GetAllAsync();
    }

    private void ToggleMenu(Guid id)
    {
        if (activeMenuId == id)
            activeMenuId = null;
        else
            activeMenuId = id;
    }

    private void SetFilter(string filter)
    {
        activeFilter = filter;
    }
}
