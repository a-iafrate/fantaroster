@using Microsoft.Extensions.Localization
@using Roster.Application.Services
@using Roster.Application.Ports.Data
@using Roster.Domain.Elements
@using Roster.Domain.Games
@inject IStringLocalizer<SharedResource> Loc
@inject ConsentManagementService ConsentService
@inject IElementRepository ElementRepository
@inject NavigationManager Navigation

<div class="mg-section">
    <div class="mg-section-title">@Loc["ConsentFlowTitle"]</div>
    <div class="mg-section-desc">@Loc["ConsentFlowDesc"]</div>

    @if (IsLoading)
    {
        <div>@Loc["Loading"]</div>
    }
    else if (!Elements.Any())
    {
        <div class="mg-alert-info">@Loc["NoElementsRequiringConsent"]</div>
    }
    else
    {
        <div class="cg-list-container">
            <div class="cg-list-header">
                <div style="flex: 2;">@Loc["ColName"]</div>
                <div>@Loc["ColStatus"]</div>
                <div style="text-align: right;">@Loc["ColActions"]</div>
            </div>
            @foreach (var element in Elements)
            {
                <div class="cg-list-row">
                    <div class="cg-list-col-bold" style="flex: 2; display: flex; align-items: center; gap: 8px;">
                        @if (!string.IsNullOrEmpty(element.ImageUrl))
                        {
                            <img src="@element.ImageUrl" alt="" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--color-line);" />
                        }
                        <div>
                            <div>@element.Name</div>
                            @if (!string.IsNullOrEmpty(element.Subtitle))
                            {
                                <div class="element-subtitle" style="font-weight: 400; font-size: 12px; color: var(--color-ink-2);">@element.Subtitle</div>
                            }
                        </div>
                    </div>
                    
                    <div>
                        <span class="element-badge badge-info">@Loc["ConsentStatus_" + element.ConsentStatus]</span>
                    </div>
                    
                    <div class="element-actions" style="justify-content: flex-end;">
                        @if (element.ConsentStatus == ConsentStatus.NotRequired || element.ConsentStatus == ConsentStatus.Declined || element.ConsentStatus == ConsentStatus.Accepted)
                        {
                            <button class="mg-btn-text" @onclick="() => GenerateLink(element.Id)" disabled="@IsProcessing">@Loc["BtnGenerateConsentLink"]</button>
                        }
                        else if (element.ConsentStatus == ConsentStatus.Pending)
                        {
                            <button class="mg-btn-text" @onclick="() => GenerateLink(element.Id)" disabled="@IsProcessing">@Loc["BtnRegenerateConsentLink"]</button>
                        }
                    </div>
                </div>
            }
        </div>
    }

    @if (GeneratedToken != null)
    {
        <div class="modal-backdrop">
            <div class="modal">
                <div class="modal-title">@Loc["ConsentLinkGenerated"]</div>
                <div class="modal-body">
                    <div class="mg-section-desc">@Loc["ConsentLinkGeneratedDesc"]</div>
                    <input class="form-control" type="text" readonly value="@GetFullLink(GeneratedToken)" />
                </div>
                <div class="modal-actions">
                    <button class="mg-btn-primary" @onclick="CloseModal">@Loc["BtnClose"]</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid GameId { get; set; }
    [Parameter, EditorRequired] public GameState GameState { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private bool IsLoading = true;
    private bool IsProcessing = false;
    private List<Element> Elements = new();
    private string? GeneratedToken;

    protected override async Task OnInitializedAsync()
    {
        await LoadElements();
    }

    private async Task LoadElements()
    {
        IsLoading = true;
        try
        {
            var allElements = await ElementRepository.GetByGameIdAsync(GameId);
            Elements = allElements.ToList(); // Optionally filter by elements needing consent
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            IsLoading = false;
        }
    }

    private string GetStatusColor(ConsentStatus status) => status switch
    {
        ConsentStatus.Accepted => "var(--color-success)",
        ConsentStatus.Pending => "var(--color-warning)",
        ConsentStatus.Declined => "var(--color-danger)",
        _ => "var(--color-ink-3)"
    };

    private async Task GenerateLink(Guid elementId)
    {
        if (IsProcessing) return;
        IsProcessing = true;
        try
        {
            GeneratedToken = await ConsentService.GenerateInvitationAsync(elementId, null);
            await LoadElements();
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync(ex.Message);
        }
        finally
        {
            IsProcessing = false;
        }
    }

    private void CloseModal()
    {
        GeneratedToken = null;
    }

    private string GetFullLink(string token)
    {
        return Navigation.ToAbsoluteUri($"/consent/{token}").ToString();
    }
}
