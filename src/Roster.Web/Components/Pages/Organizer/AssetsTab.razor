@using Roster.Domain.Games
@inject IStringLocalizer<SharedResource> Loc
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Join materials (mockup 03, screen 14): QR and code, a link to copy, the poster and the big screen. *@
<div class="ds-page assets">
    <header class="ds-page-header">
        <div class="ds-page-heading">
            <h1 class="ds-page-title">@Loc["NavMaterials"]</h1>
            <p class="ds-page-desc">@Loc["MaterialsDesc"]</p>
        </div>
    </header>

    <div class="assets__layout">
        <section class="ds-panel assets__qr" aria-labelledby="assets-qr-title">
            <h2 class="visually-hidden" id="assets-qr-title">@Loc["PrintableQr"]</h2>
            <div class="ds-qr" role="img" aria-label="@Loc["PrintableQr"]">
                @((MarkupString)GenerateQrCodeSvg(JoinUrl))
            </div>
            <div class="assets__code" aria-label="@Loc["JoinCode"]">@Game.JoinCode</div>
            <p class="ds-muted assets__hint">@Loc["PrintableQrDesc"]</p>
        </section>

        <div class="assets__side">
            <div class="ds-link-field">
                <span>@JoinUrl</span>
                <button type="button" class="ds-btn ds-btn--primary" @onclick="CopyAsync"><i class="icon-copy" aria-hidden="true"></i>@(_copied ? Loc["LinkCopied"] : Loc["BtnCopyLink"])</button>
            </div>
            <p class="ds-muted assets__hint">@Loc["JoinUrlDesc"]</p>

            <a class="assets__link" href="/organizer/games/@Game.Id/poster" target="_blank" rel="noopener">
                <i class="icon-file-text" aria-hidden="true"></i><span>@Loc["BtnPrintPoster"]</span><i class="icon-external-link" aria-hidden="true"></i><span class="visually-hidden">@Loc["OpensNewTab"]</span>
            </a>
            <a class="assets__link" href="/games/@Game.Id/big-screen" target="_blank" rel="noopener">
                <i class="icon-monitor" aria-hidden="true"></i><span>@Loc["OpenBigScreen"]</span><i class="icon-external-link" aria-hidden="true"></i><span class="visually-hidden">@Loc["OpensNewTab"]</span>
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Game Game { get; set; } = null!;
    [Parameter] public EventCallback<string> OnError { get; set; }

    private bool _copied;

    private string JoinUrl => Navigation.ToAbsoluteUri($"/join/{Game.JoinCode}").AbsoluteUri;

    private async Task CopyAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", JoinUrl);
        _copied = true;
    }

    private static string GenerateQrCodeSvg(string text)
    {
        var qr = Net.Codecrete.QrCodeGenerator.QrCode.EncodeText(text, Net.Codecrete.QrCodeGenerator.QrCode.Ecc.Medium);
        return qr.ToSvgString(4).Replace("stroke=\"none\" fill=\"#000000\"", "stroke=\"none\" fill=\"currentColor\"");
    }
}
