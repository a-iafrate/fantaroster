@page "/login"
@layout Roster.Web.Components.Layout.EmptyLayout
@using Microsoft.AspNetCore.Identity
@using Roster.Infrastructure.Data
@inject ILogger<Login> Logger
@inject UserManager<OrganizerUser> UserManager
@inject IEmailSender<OrganizerUser> EmailSender
@inject LinkGenerator LinkGenerator
@inject IHttpContextAccessor HttpContextAccessor
@inject IStringLocalizer<SharedResource> Loc

<PageTitle>@Loc["LoginPageTitle"]</PageTitle>

@* Sign in (mockup 05): the form, "check your inbox" and "link expired" states. No password: a magic link by email. *@
<div class="auth">
    <aside class="auth__panel" data-theme="stage" aria-hidden="true">
        <a href="/" class="auth__brand" tabindex="-1"><img src="assets/logo-r.svg" alt="" /><BrandWordmark /></a>
        <div class="auth__cards">
            <span class="auth__card auth__card--cyan"></span>
            <span class="auth__card auth__card--blue"></span>
            <span class="auth__card auth__card--main">
                <span class="auth__card-top"><i class="icon-star"></i><span class="ds-points">+10</span></span>
                <span class="auth__card-label">@Loc["HeroCardLabel"]</span>
            </span>
        </div>
        <div class="auth__pitch">
            <p class="auth__pitch-title">@Loc["HeroTitle"]</p>
            <p class="auth__pitch-sub">@Loc["HeroSub"]</p>
        </div>
    </aside>

    <main class="auth__main">
        <a href="/" class="auth__brand auth__brand--mobile"><img src="assets/logo-r.svg" alt="" /><BrandWordmark /></a>

        <div class="auth__box">
            @if (ErrorParam == "invalid_link")
            {
                <span class="auth__icon auth__icon--warn" aria-hidden="true"><i class="icon-timer-off"></i></span>
                <h1 class="auth__title">@Loc["LoginExpiredTitle"]</h1>
                <p class="auth__text">@Loc["LoginExpiredBody"]</p>
                <a href="/login" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary"><i class="icon-send" aria-hidden="true"></i>@Loc["LoginExpiredCta"]</a>
            }
            else if (_showSuccessMessage)
            {
                <span class="auth__icon" aria-hidden="true"><i class="icon-mail-check"></i></span>
                <h1 class="auth__title">@Loc["LoginSentTitle"]</h1>
                <p class="auth__text">@string.Format(Loc["LoginSentBody"], Email)</p>
                <p class="ds-alert ds-alert--info"><i class="icon-info" aria-hidden="true"></i> @Loc["LoginSentHint"]</p>
                <a href="mailto:" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary"><i class="icon-mail" aria-hidden="true"></i>@Loc["LoginOpenMail"]</a>
                <a href="/login" class="ds-btn ds-btn--block ds-btn--link">@Loc["LoginWrongEmail"]</a>
            }
            else
            {
                <h1 class="auth__title">@Loc["LoginTitle"]</h1>
                <p class="auth__text">@Loc["LoginIntro"]</p>

                <EditForm Model="this" OnValidSubmit="HandleSubmit" FormName="login-form" class="ds-form">
                    <div class="ds-field">
                        <label for="email" class="ds-label">@Loc["LoginEmail"]</label>
                        <InputText id="email" @bind-Value="Email" class="ds-input" type="email" required autocomplete="email" inputmode="email" placeholder="@Loc["LoginEmailPlaceholder"]" />
                    </div>
                    <button type="submit" disabled="@_isSubmitting" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary">
                        <i class="icon-send" aria-hidden="true"></i>@(_isSubmitting ? Loc["LoginSending"] : Loc["LoginSend"])
                    </button>
                </EditForm>

                <p class="auth__footer">@Loc["LoginJustPlaying"] <a href="/j">@Loc["PubHaveCode"]</a></p>
            }
        </div>
    </main>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorParam { get; set; }

    [SupplyParameterFromForm]
    public string? Email { get; set; }

    private bool _isSubmitting;
    private bool _showSuccessMessage;

    private async Task HandleSubmit()
    {
        if (string.IsNullOrWhiteSpace(Email))
            return;

        _isSubmitting = true;

        var delay = Random.Shared.Next(100, 500);
        await Task.Delay(delay);

        var user = await UserManager.FindByEmailAsync(Email);

        if (user == null)
        {
            user = new OrganizerUser
            {
                UserName = Email,
                Email = Email,
                DisplayName = Email.Split('@')[0]
            };
            var createResult = await UserManager.CreateAsync(user);
            if (!createResult.Succeeded)
            {
                Logger.LogWarning("Failed to auto-provision user {Email}", Email);
                _showSuccessMessage = true;
                _isSubmitting = false;
                return;
            }
        }

        var token = await UserManager.GenerateUserTokenAsync(user, TokenOptions.DefaultProvider, "MagicLink");

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext != null)
        {
            var link = LinkGenerator.GetUriByName(httpContext, "VerifyMagicLink", new { email = Email, token });
            if (link != null)
            {
                await EmailSender.SendPasswordResetLinkAsync(user, Email, link);
            }
        }

        _showSuccessMessage = true;
        _isSubmitting = false;
    }
}
