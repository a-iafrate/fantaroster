@inject IBrandAccessor Brand
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-brand="@Brand.Current.Id">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <base href="/" />
    <meta name="theme-color" content="@Brand.Current.ThemeColor" />
    <script src="@Assets["js/theme.js"]"></script>
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["fonts/plus-jakarta-sans.css"]" />
    <link rel="stylesheet" href="@Assets["fonts/lucide.css"]" />
    <link rel="stylesheet" href="@Assets["css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Roster.Ui/roster-ui.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Roster.Ui/roster-ui-app.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["Roster.Web.styles.css"]" />
    <link rel="stylesheet" href="@Assets["Roster.Web.Client.styles.css"]" />
    <ImportMap nonce="@Nonce" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="manifest" href="manifest.webmanifest" />
    <HeadOutlet @rendermode="HeadRenderMode" />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["js/boot.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    // A page title set by an interactive page (PageTitle) only reaches the document when the head outlet is interactive too,
    // so it takes the render mode the routed page asked for; static pages keep a static head.
    private IComponentRenderMode? HeadRenderMode =>
        HttpContext?.GetEndpoint()?.Metadata.GetMetadata<RenderModeAttribute>()?.Mode;

    // The one inline script Blazor writes (the import map) is allowed by this per-response nonce.
    private string? Nonce => HttpContext?.Items[Roster.Web.Security.SecurityHeadersMiddleware.NonceKey] as string;
}
