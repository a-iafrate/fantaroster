@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (!IsOnline)
{
    <div class="connection-status offline">
        Offline - Trying to reconnect...
    </div>
}

@code {
    private bool IsOnline { get; set; } = true;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ConnectionStatus>? _objRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./Shared/ConnectionStatus.razor.js");
            _objRef = DotNetObjectReference.Create(this);
            IsOnline = await _module.InvokeAsync<bool>("initialize", _objRef);
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void UpdateStatus(bool isOnline)
    {
        IsOnline = isOnline;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose");
            await _module.DisposeAsync();
        }
        _objRef?.Dispose();
    }
}
