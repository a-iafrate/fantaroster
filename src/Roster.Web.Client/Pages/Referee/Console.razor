@page "/games/{GameId:guid}/referee"
@rendermode ClientRenderMode.Instance
@implements IDisposable
@inject RefereeSession Session
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject IStringLocalizer<RefereeResource> Loc
@inject IStringLocalizer<ParticipantResource> Shared

<PageTitle>@Loc["PageTitle"]</PageTitle>

@switch (Session.Status)
{
    case RefereeSessionStatus.Ready when Session.Game is { } game:
        @if (_view == ConsoleView.Assign)
        {
            <header class="ref-bar">
                @if (_step > 1)
                {
                    <button type="button" class="ref-back" aria-label="@Loc["Back"]" @onclick="GoBack"><i class="icon-arrow-left" aria-hidden="true"></i></button>
                }
                <div class="ref-titles">
                    <div class="ref-sub">@string.Format(Loc["StepOf"], game.Name, _step)</div>
                    <h1 class="ref-title" tabindex="-1" @ref="_title">@StepTitle()</h1>
                </div>
                <span class="ds-badge ds-badge--surface"><span class="ds-live-dot @(game.IsLive ? "" : "ref-dot--idle")" aria-hidden="true"></span>@(game.IsLive ? Loc["Live"] : game.IsOver ? Loc["Over"] : Loc["NotStarted"])</span>
                <button type="button" class="ref-menu-btn" aria-label="@Loc["Menu"]" aria-haspopup="dialog" aria-expanded="@(_menuOpen ? "true" : "false")" @onclick="OpenMenu">
                    <i class="icon-menu" aria-hidden="true"></i>
                </button>
            </header>
            <div class="ref-steps" aria-hidden="true">
                @for (var i = 1; i <= 3; i++)
                {
                    <span class="ref-step @(i <= _step ? "ref-step--on" : "")"></span>
                }
            </div>

            @if (!Session.CanAssign)
            {
                <p class="ds-alert ds-alert--info ref-notice" role="status">@(game.IsOver ? Loc["GameOver"] : Loc["GameNotLive"])</p>
            }
            @if (Session.PendingCount > 0 || !Session.IsOnline)
            {
                <p class="ref-offline" role="status"><i class="icon-wifi-off" aria-hidden="true"></i>@OfflineText()</p>
            }

            @if (_step == 1)
            {
                <div class="ref-body">
                    @if (Session.Elements.Count > SearchThreshold)
                    {
                        <label class="ds-search">
                            <span class="visually-hidden">@string.Format(Loc["SearchElements"], game.Terms.ElementPlural)</span>
                            <i class="icon-search" aria-hidden="true"></i>
                            <input type="search" class="ds-input" autocomplete="off" placeholder="@string.Format(Loc["SearchElements"], game.Terms.ElementPlural)" @bind="_search" @bind:event="oninput" />
                        </label>
                    }
                    <ul class="ref-grid" aria-label="@game.Terms.ElementPlural">
                        @foreach (var element in FilteredElements())
                        {
                            <li>
                                <button type="button" class="ref-tile" disabled="@(!Session.CanAssign)" @onclick="() => SelectElement(element)">
                                    <Avatar Name="@element.Name" Seed="@element.Id.ToString()" ImageUrl="@element.ImageUrl" Size="AvatarSize.L" />
                                    <span class="ref-tile__name">@element.Name</span>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (Session.Elements.Count == 0)
                    {
                        <p class="ds-muted">@Loc["NoElements"]</p>
                    }
                </div>
            }
            else if (_step == 2 && _element is { } picked)
            {
                <div class="ref-body">
                    <div class="ref-chip">
                        <Avatar Name="@picked.Name" Seed="@picked.Id.ToString()" ImageUrl="@picked.ImageUrl" />
                        <span class="ref-chip__name">@picked.Name</span>
                    </div>
                    <ul class="ref-rules">
                        @foreach (var rule in Session.ElementRules)
                        {
                            <li>
                                <button type="button" class="ref-rule" @onclick="() => SelectRule(rule)">
                                    <span class="ref-rule__label">@rule.Label</span>
                                    <span class="ref-pts @(rule.Points < 0 ? "ref-pts--penalty" : "")">@ParticipantFormat.Points(rule.Points)</span>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (Session.ElementRules.Count == 0)
                    {
                        <p class="ds-muted">@Loc["NoRules"]</p>
                    }
                </div>
            }
            else if (_step == 3 && _element is { } target && _rule is { } chosen)
            {
                <div class="ref-body ref-confirm">
                    <section class="ref-confirm__card" aria-labelledby="ref-confirm-who">
                        <Avatar Name="@target.Name" Seed="@target.Id.ToString()" ImageUrl="@target.ImageUrl" Size="AvatarSize.L" />
                        <div class="ref-confirm__who" id="ref-confirm-who">@target.Name</div>
                        <div class="ds-muted">@chosen.Label</div>
                        <div class="ref-pts ref-pts--big @(chosen.Points < 0 ? "ref-pts--penalty" : "")">@ParticipantFormat.Points(chosen.Points)</div>
                    </section>
                    @if (_error is not null)
                    {
                        <p class="ds-alert" role="alert">@_error</p>
                    }
                    <button type="button" class="ref-confirm__btn" disabled="@_sending" @onclick="ConfirmAsync">
                        @string.Format(Loc["Assign"], ParticipantFormat.Points(chosen.Points))
                    </button>
                </div>
            }

            @if (_last is { } last)
            {
                <div class="ref-undo" role="status">
                    <span class="ref-undo__bar" style="width: @(_undoSeconds * 10)%"></span>
                    <i class="@(last.Result.Status == AssignStatus.Queued ? "icon-clock" : "icon-check")" aria-hidden="true"></i>
                    <span class="ref-undo__text">@last.Label</span>
                    <button type="button" class="ref-undo__btn" @onclick="UndoAsync">@string.Format(Loc["Undo"], _undoSeconds)</button>
                </div>
            }
        }
        else
        {
            <header class="ref-bar">
                <button type="button" class="ref-back" aria-label="@Loc["Back"]" @onclick="CloseView"><i class="icon-arrow-left" aria-hidden="true"></i></button>
                <div class="ref-titles">
                    <h1 class="ref-title" tabindex="-1" @ref="_title">@(_view == ConsoleView.Recent ? Loc["RecentPoints"] : Loc["Rules"])</h1>
                </div>
            </header>

            @if (_view == ConsoleView.Recent)
            {
                @if (Session.PendingCount > 0 || !Session.IsOnline)
                {
                    <div class="ref-banner" role="status">
                        <i class="icon-wifi-off" aria-hidden="true"></i>
                        <div>
                            <div class="ref-banner__title">@OfflineText()</div>
                            <div class="ref-banner__sub">@Loc["OfflineSub"]</div>
                        </div>
                    </div>
                }
                var recent = Session.RecentPoints();
                <ul class="ref-recent">
                    @foreach (var point in recent)
                    {
                        <li class="ref-point @(point.Status == RecentPointStatus.Voided ? "ref-point--voided" : "")">
                            <span class="ref-pts ref-pts--small @(point.Points < 0 ? "ref-pts--penalty" : "") @(point.Status == RecentPointStatus.Voided ? "ref-pts--voided" : "")">@ParticipantFormat.Points(point.Points)</span>
                            <div class="ref-point__text">
                                <div class="ref-point__who">@(string.IsNullOrEmpty(point.ElementName) ? Loc["Unknown"] : point.ElementName)</div>
                                <div class="ref-point__status">
                                    <i class="@StatusIcon(point.Status)" aria-hidden="true"></i>@StatusText(point)
                                </div>
                            </div>
                            @if (point.Status != RecentPointStatus.Voided && (Session.CanAssign || point.Status == RecentPointStatus.Pending))
                            {
                                <button type="button" class="ref-point__void" @onclick="() => VoidPointAsync(point)">@Loc["Void"]</button>
                            }
                        </li>
                    }
                </ul>
                @if (recent.Count == 0)
                {
                    <p class="ds-muted ref-empty">@Loc["NoPointsYet"]</p>
                }
            }
            else
            {
                <ul class="ref-rules ref-body">
                    @foreach (var rule in Session.Rules.Where(r => !r.IsPersonal).OrderByDescending(r => r.Points))
                    {
                        <li class="ref-rule ref-rule--static">
                            <span class="ref-rule__label">@rule.Label</span>
                            <span class="ref-pts @(rule.Points < 0 ? "ref-pts--penalty" : "")">@ParticipantFormat.Points(rule.Points)</span>
                        </li>
                    }
                </ul>
            }
        }

        @if (_menuOpen)
        {
            <button type="button" class="ds-scrim" tabindex="-1" aria-label="@Loc["Close"]" @onclick="CloseMenu"></button>
            <div class="ds-sheet" role="dialog" aria-modal="true" aria-label="@Loc["Menu"]" @onkeydown="OnMenuKeyDown">
                <div class="ds-sheet__grabber" aria-hidden="true"></div>
                <button type="button" class="ds-menu-item ref-menu-item" @ref="_firstMenuItem" @onclick="() => OpenView(ConsoleView.Recent)">
                    <i class="icon-history" aria-hidden="true"></i><span>@Loc["RecentPoints"]</span>
                    @if (Session.PendingCount > 0)
                    {
                        <span class="ds-menu-item__value">@string.Format(Loc["PendingCount"], Session.PendingCount)</span>
                    }
                </button>
                <button type="button" class="ds-menu-item ref-menu-item" @onclick="() => OpenView(ConsoleView.Rules)">
                    <i class="icon-scale" aria-hidden="true"></i><span>@Loc["Rules"]</span>
                </button>
                <ThemeToggle CssClass="ds-menu-item ref-menu-item" ShowCaption="true" />
                <button type="button" class="ds-menu-item ref-menu-item" @onclick="OpenHelp">
                    <i class="icon-circle-help" aria-hidden="true"></i><span>@Loc["Help"]</span>
                </button>
                <hr class="ds-menu-separator" />
                <button type="button" class="ds-menu-item ds-menu-item--danger ref-menu-item" @onclick="AskExit">
                    <i class="icon-log-out" aria-hidden="true"></i><span>@Loc["Exit"]</span>
                </button>
            </div>
        }

        @if (_dialog != ConsoleDialog.None)
        {
            <button type="button" class="ds-scrim" tabindex="-1" aria-label="@Loc["Close"]" @onclick="CloseDialog"></button>
            <div class="ds-dialog" role="alertdialog" aria-modal="true" aria-labelledby="ref-dialog-title">
                @if (_dialog == ConsoleDialog.Help)
                {
                    <h2 class="ds-heading" id="ref-dialog-title">@Loc["HelpTitle"]</h2>
                    <ol class="ref-help">
                        <li>@string.Format(Loc["HelpStep1"], Session.Game?.Terms.ElementSingular.ToLower(System.Globalization.CultureInfo.CurrentCulture))</li>
                        <li>@Loc["HelpStep2"]</li>
                        <li>@Loc["HelpStep3"]</li>
                    </ol>
                    <button type="button" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary ref-dialog-btn" @onclick="CloseDialog">@Loc["Close"]</button>
                }
                else
                {
                    <h2 class="ds-heading" id="ref-dialog-title">@Loc["ExitTitle"]</h2>
                    <p class="ds-muted">@(Session.PendingCount > 0 ? string.Format(Loc["ExitBodyPending"], Session.PendingCount) : Loc["ExitBody"])</p>
                    <button type="button" class="ds-btn ds-btn--l ds-btn--block ds-btn--danger ref-dialog-btn" @onclick="ExitAsync">@Loc["ExitConfirm"]</button>
                    <button type="button" class="ds-btn ds-btn--l ds-btn--block ds-btn--secondary ref-dialog-btn" @onclick="CloseDialog">@Loc["Cancel"]</button>
                }
            </div>
        }
        break;

    case RefereeSessionStatus.NeedsInvite:
        <div class="ref-message">
            <h1 class="ds-title">@Loc["NeedsInviteTitle"]</h1>
            <p class="ds-muted">@Loc["NeedsInviteBody"]</p>
        </div>
        break;

    case RefereeSessionStatus.NotFound:
        <div class="ref-message">
            <h1 class="ds-title">@Loc["GameNotFoundTitle"]</h1>
            <p class="ds-muted">@Loc["GameNotFoundBody"]</p>
        </div>
        break;

    case RefereeSessionStatus.Error:
        <div class="ref-message">
            <h1 class="ds-title">@Loc["LoadFailedTitle"]</h1>
            <p class="ds-muted">@Loc["LoadFailedBody"]</p>
            <button type="button" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary ref-dialog-btn" @onclick="LoadAsync">@Loc["Retry"]</button>
        </div>
        break;

    default:
        <div class="ref-message" role="status"><span class="visually-hidden">@Shared["Loading"]</span></div>
        break;
}

@code {
    private const int SearchThreshold = 8;
    private const int UndoWindowSeconds = 10;

    private enum ConsoleView { Assign, Recent, Rules }

    private enum ConsoleDialog { None, Help, Exit }

    private sealed record LastPoint(AssignResult Result, string Label);

    [Parameter]
    public Guid GameId { get; set; }

    private ConsoleView _view;
    private ConsoleDialog _dialog;
    private int _step = 1;
    private AvailableElement? _element;
    private GameRule? _rule;
    private string _search = string.Empty;
    private string? _error;
    private bool _sending;
    private bool _menuOpen;
    private LastPoint? _last;
    private int _undoSeconds;
    private ITimer? _undoTimer;
    private ElementReference _title;
    private ElementReference _firstMenuItem;
    private bool _focusTitle;
    private bool _focusMenu;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusMenu && _menuOpen)
        {
            _focusMenu = false;
            await _firstMenuItem.FocusAsync();
        }
        else if (_focusTitle)
        {
            _focusTitle = false;
            await _title.FocusAsync();
        }
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _undoTimer?.Dispose();
    }

    private async Task LoadAsync()
    {
        // The invite link carries the token in the fragment, which never reaches the server.
        var uri = new Uri(Navigation.Uri);
        string? token = null;
        if (uri.Fragment.StartsWith("#t=", StringComparison.Ordinal))
        {
            token = Uri.UnescapeDataString(uri.Fragment["#t=".Length..]);
        }

        await Session.EnsureLoadedAsync(GameId, token);
        if (token is not null)
        {
            Navigation.NavigateTo(uri.GetLeftPart(UriPartial.Path), replace: true);
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private IEnumerable<AvailableElement> FilteredElements() =>
        string.IsNullOrWhiteSpace(_search)
            ? Session.Elements
            : Session.Elements.Where(e => e.Name.Contains(_search, StringComparison.CurrentCultureIgnoreCase)
                || (e.Group?.Contains(_search, StringComparison.CurrentCultureIgnoreCase) ?? false));

    private string StepTitle() => _step switch
    {
        1 => string.Format(Loc["PickElement"], Session.Game?.Terms.ElementSingular.ToLower(System.Globalization.CultureInfo.CurrentCulture)),
        2 => Loc["PickRule"],
        _ => Loc["ConfirmTitle"],
    };

    private string OfflineText() => Session.PendingCount > 0
        ? string.Format(Loc["OfflinePending"], Session.PendingCount)
        : Loc["Offline"];

    private void SelectElement(AvailableElement element)
    {
        _element = element;
        _error = null;
        GoToStep(2);
    }

    private void SelectRule(GameRule rule)
    {
        _rule = rule;
        _error = null;
        GoToStep(3);
    }

    private void GoBack() => GoToStep(_step - 1);

    private void GoToStep(int step)
    {
        _step = step;
        _focusTitle = true;
    }

    private async Task ConfirmAsync()
    {
        if (_element is not { } element || _rule is not { } rule || _sending)
        {
            return;
        }

        _sending = true;
        _error = null;
        var result = await Session.AssignAsync(element.Id, rule);
        _sending = false;

        switch (result.Status)
        {
            case AssignStatus.Rejected:
                _error = Loc["Rejected"];
                return;
            case AssignStatus.NotAuthorized:
                return;
        }

        var label = $"{ParticipantFormat.Points(rule.Points)} {element.Name}";
        _last = new LastPoint(result, result.Status == AssignStatus.Queued ? string.Format(Loc["QueuedLabel"], label) : label);
        StartUndoCountdown();
        _element = null;
        _rule = null;
        GoToStep(1);
    }

    private void StartUndoCountdown()
    {
        _undoTimer?.Dispose();
        _undoSeconds = UndoWindowSeconds;
        _undoTimer = Time.CreateTimer(_ => InvokeAsync(TickUndo), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private void TickUndo()
    {
        _undoSeconds--;
        if (_undoSeconds <= 0)
        {
            ClearUndo();
        }
        StateHasChanged();
    }

    private void ClearUndo()
    {
        _undoTimer?.Dispose();
        _undoTimer = null;
        _last = null;
    }

    private async Task UndoAsync()
    {
        if (_last is not { } last)
        {
            return;
        }
        ClearUndo();
        await Session.UndoAsync(last.Result);
    }

    private async Task VoidPointAsync(RecentPoint point)
    {
        if (point.EntryId is { } entryId)
        {
            await Session.VoidAsync(entryId);
        }
        else if (point.PendingKey is { } key)
        {
            await Session.UndoAsync(new AssignResult(AssignStatus.Queued, PendingKey: key));
        }
    }

    private static string StatusIcon(RecentPointStatus status) => status switch
    {
        RecentPointStatus.Pending => "icon-clock",
        RecentPointStatus.Voided => "icon-ban",
        _ => "icon-check",
    };

    private string StatusText(RecentPoint point) => point.Status switch
    {
        RecentPointStatus.Pending => $"{point.RuleLabel}: {Loc["StatusPending"]}",
        RecentPointStatus.Voided => $"{point.RuleLabel}: {Loc["StatusVoided"]}",
        _ => point.RuleLabel,
    };

    private void OpenMenu()
    {
        _menuOpen = true;
        _focusMenu = true;
    }

    private void CloseMenu() => _menuOpen = false;

    private void OnMenuKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseMenu();
        }
    }

    private void OpenView(ConsoleView view)
    {
        _menuOpen = false;
        _view = view;
        _focusTitle = true;
    }

    private void CloseView()
    {
        _view = ConsoleView.Assign;
        _focusTitle = true;
    }

    private void OpenHelp()
    {
        _menuOpen = false;
        _dialog = ConsoleDialog.Help;
    }

    private void AskExit()
    {
        _menuOpen = false;
        _dialog = ConsoleDialog.Exit;
    }

    private void CloseDialog() => _dialog = ConsoleDialog.None;

    private async Task ExitAsync()
    {
        _dialog = ConsoleDialog.None;
        await Session.LeaveAsync();
    }
}
