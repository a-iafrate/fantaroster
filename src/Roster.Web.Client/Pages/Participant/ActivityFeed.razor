@page "/games/{GameId:guid}/activity"
@rendermode ClientRenderMode.Instance
@implements IDisposable
@inject ParticipantSession Session
@inject TimeProvider Time
@inject IStringLocalizer<ParticipantResource> Loc

<PageTitle>@Loc["TabFeed"]</PageTitle>

<ParticipantShell GameId="GameId" Tab="ParticipantTab.Feed">
    @if (Session.Status == ParticipantSessionStatus.Ready)
    {
        var now = Time.GetUtcNow();
        var items = _mineOnly ? Session.Feed.Where(IsMine).ToList() : Session.Feed.ToList();

        <div class="feed">
            <div class="ds-segmented" role="group" aria-label="@Loc["FeedFilter"]">
                <button type="button" aria-pressed="@(!_mineOnly ? "true" : "false")" @onclick="() => _mineOnly = false">@Loc["FeedAll"]</button>
                <button type="button" aria-pressed="@(_mineOnly ? "true" : "false")" @onclick="() => _mineOnly = true">@Loc["FeedMine"]</button>
            </div>

            @if (items.Count == 0)
            {
                <p class="ds-muted feed__empty">@(_mineOnly ? Loc["NoActivityForMe"] : Loc["NoActivityYet"])</p>
            }
            else
            {
                <ul class="feed__list">
                    @foreach (var item in items)
                    {
                        <li class="feed__item @(item.IsVoided ? "feed__item--voided" : "")">
                            <span class="ds-points @(item.IsVoided ? "ds-points--voided" : item.Points < 0 ? "ds-points--penalty" : "")">@ParticipantFormat.Points(item.Points)</span>
                            <div class="feed__text">
                                <div class="feed__who">
                                    @(item.ElementName ?? item.ParticipantNickname ?? Loc["Unknown"])
                                    @if (IsMine(item))
                                    {
                                        <i class="icon-layers feed__mine" aria-hidden="true" title="@Loc["InYourLineup"]"></i>
                                        <span class="visually-hidden">@Loc["InYourLineup"]</span>
                                    }
                                </div>
                                <div class="feed__rule">@(item.IsVoided ? string.Format(Loc["VoidedRule"], item.RuleLabel) : item.RuleLabel)</div>
                            </div>
                            <time class="feed__time" datetime="@item.CreatedAt.ToString("O")">@ParticipantFormat.Ago(item.CreatedAt, now, Loc)</time>
                        </li>
                    }
                </ul>
            }
        </div>
    }
</ParticipantShell>

@code {
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(30);

    [Parameter]
    public Guid GameId { get; set; }

    private bool _mineOnly;
    private ITimer? _clock;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        // Keeps "4 min" current without refetching.
        _clock = Time.CreateTimer(_ => InvokeAsync(StateHasChanged), null, RefreshInterval, RefreshInterval);
    }

    protected override void OnAfterRender(bool firstRender) => Session.MarkPointsSeen();

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _clock?.Dispose();
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private bool IsMine(FeedItem item) =>
        item.ParticipantId is { } participantId
            ? participantId == Session.Profile?.Id
            : item.ElementId is { } elementId && Session.Lineup?.PickedElementIds.Contains(elementId) == true;
}
