@page "/j"
@inject NavigationManager Navigation

<PageTitle>Enter Join Code</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm text-center p-4">
                <div class="mb-4">
                    <i class="icon-qr-code" style="font-size: 48px; color: var(--color-primary, #3b82f6);"></i>
                </div>
                <h2 class="h4 mb-3">Join a Game</h2>
                <p class="text-muted mb-4">Enter the 5-character join code provided by the organizer.</p>
                
                <form @onsubmit="Submit">
                    <div class="mb-3">
                        <input type="text" class="form-control form-control-lg text-center" style="letter-spacing: 0.25em; text-transform: uppercase;" 
                               placeholder="XXXXX" maxlength="5" @bind="_joinCode" @bind:event="oninput" />
                    </div>
                    
                    <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@(string.IsNullOrWhiteSpace(_joinCode) || _joinCode.Length != 5)">
                        Go to Game
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@code {
    private string _joinCode = string.Empty;

    private void Submit()
    {
        if (!string.IsNullOrWhiteSpace(_joinCode) && _joinCode.Length == 5)
        {
            Navigation.NavigateTo($"/join/{_joinCode.ToUpperInvariant()}");
        }
    }
}
