@page "/j"
@rendermode ClientRenderMode.Instance
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IStringLocalizer<ParticipantResource> Loc

<PageTitle>@Loc["EnterCodePageTitle"]</PageTitle>

<div class="code">
    <img class="code__logo" src="assets/logo-r.svg" alt="" />

    <div class="code__intro">
        <span class="code__icon" aria-hidden="true"><i class="icon-qr-code"></i></span>
        <h1 class="ds-title">@Loc["EnterCodeTitle"]</h1>
        <p class="ds-muted">@Loc["EnterCodeHelp"]</p>
    </div>

    <form class="code__form" @onsubmit="SubmitAsync" novalidate>
        <div>
            <label class="ds-label" for="join-code">@Loc["JoinCodeLabel"]</label>
            <input id="join-code" class="ds-input code__input" type="text" inputmode="text" autocapitalize="characters" autocomplete="off"
                   spellcheck="false" maxlength="@CodeLength"
                   aria-describedby="@(_error is null ? null : "join-code-error")"
                   aria-invalid="@(_error is null ? null : "true")"
                   @bind="_code" @bind:event="oninput" />
            @if (_error is not null)
            {
                <p class="ds-alert code__error" id="join-code-error" role="alert">@_error</p>
            }
        </div>
        <button type="submit" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary" disabled="@(!IsComplete || _checking)">
            @Loc["GoToGame"]
        </button>
    </form>
</div>

@code {
    private const int CodeLength = 5;

    private string _code = string.Empty;
    private bool _checking;
    private string? _error;

    private bool IsComplete => _code.Trim().Length == CodeLength;

    private async Task SubmitAsync()
    {
        if (!IsComplete || _checking)
        {
            return;
        }

        _checking = true;
        _error = null;
        try
        {
            var code = Uri.EscapeDataString(_code.Trim().ToUpperInvariant());
            using var response = await Http.GetAsync(new Uri($"/api/join-codes/{code}", UriKind.Relative));
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<JoinCodeResponse>() is { } result)
            {
                Navigation.NavigateTo(ParticipantRoutes.Join(result.GameId));
                return;
            }

            _error = response.StatusCode == System.Net.HttpStatusCode.NotFound
                ? Loc["JoinCodeNotFound"]
                : Loc["NetworkErrorTryAgain"];
        }
        catch (HttpRequestException)
        {
            _error = Loc["NetworkErrorTryAgain"];
        }
        finally
        {
            _checking = false;
        }
    }

    private sealed record JoinCodeResponse(Guid GameId);
}
