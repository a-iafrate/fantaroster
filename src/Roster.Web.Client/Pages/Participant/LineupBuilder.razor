@page "/games/{GameId:guid}/lineup"
@rendermode ClientRenderMode.Instance
@implements IDisposable
@inject ParticipantSession Session
@inject NavigationManager Navigation
@inject IStringLocalizer<ParticipantResource> Loc

<PageTitle>@Loc["TabLineup"]</PageTitle>

<ParticipantShell GameId="GameId" Tab="ParticipantTab.Lineup">
    <HeaderExtra>
        @if (_editing && Session.Game is { } game)
        {
            <span class="ds-badge ds-badge--tint"><i class="icon-layers" aria-hidden="true"></i>@string.Format(Loc["LineupCount"], _picked.Count, game.LineupSize)</span>
        }
    </HeaderExtra>
    <ChildContent>
        @if (Session.Game is not { } game || Session.Elements is null)
        {
            <div class="lineup__skeleton" role="status">
                <span class="visually-hidden">@Loc["Loading"]</span>
            </div>
        }
        else if (_editing)
        {
            <div class="lineup">
                <div class="lineup__filters">
                    <label class="ds-search">
                        <span class="visually-hidden">@string.Format(Loc["SearchElements"], game.Terms.ElementPlural.ToLower(System.Globalization.CultureInfo.CurrentCulture))</span>
                        <i class="icon-search" aria-hidden="true"></i>
                        <input type="search" class="ds-input" autocomplete="off"
                               placeholder="@string.Format(Loc["SearchElements"], game.Terms.ElementPlural.ToLower(System.Globalization.CultureInfo.CurrentCulture))"
                               @bind="_search" @bind:event="oninput" />
                    </label>

                    @if (_groups.Count > 1)
                    {
                        <div class="ds-chips" role="group" aria-label="@string.Format(Loc["FilterByGroup"], game.Terms.GroupLabel)">
                            <button type="button" class="ds-chip" aria-pressed="@(_group is null ? "true" : "false")" @onclick="() => _group = null">@Loc["AllGroups"]</button>
                            @foreach (var group in _groups)
                            {
                                <button type="button" class="ds-chip" aria-pressed="@(_group == group ? "true" : "false")" @onclick="() => _group = group">@group</button>
                            }
                        </div>
                    }
                </div>

                <ul class="lineup__list" aria-label="@game.Terms.ElementPlural">
                    @foreach (var element in FilteredElements)
                    {
                        var state = StateOf(element.Id);
                        <li>
                            <ElementCard Name="@element.Name"
                                         Subtitle="@Subtitle(element)"
                                         ImageUrl="@element.ImageUrl"
                                         Seed="@element.Id.ToString()"
                                         State="state"
                                         CaptainEnabled="game.CaptainEnabled"
                                         CaptainLabel="@ParticipantFormat.Multiplier(game.CaptainMultiplier)"
                                         MakeCaptainLabel="@string.Format(Loc["MakeCaptain"], element.Name)"
                                         IsDisabled="@(state == ElementPickState.Free && _picked.Count >= game.LineupSize)"
                                         OnToggle="() => Toggle(element.Id, game)"
                                         OnMakeCaptain="() => _captain = element.Id" />
                        </li>
                    }
                </ul>

                @if (!FilteredElements.Any())
                {
                    <p class="ds-muted lineup__empty">@string.Format(Loc["NoElementsFound"], game.Terms.ElementPlural.ToLower(System.Globalization.CultureInfo.CurrentCulture))</p>
                }

                <div class="lineup__savebar">
                    <p class="lineup__hint" aria-live="polite"><i class="icon-star" aria-hidden="true"></i>@Hint(game)</p>
                    @if (_saveError is not null)
                    {
                        <p class="ds-alert" role="alert">@_saveError</p>
                    }
                    <button type="button" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary" disabled="@(!CanSave(game) || _saving)" @onclick="SaveAsync">
                        @(_saving ? Loc["Saving"] : Loc["SaveLineup"])
                    </button>
                </div>
            </div>
        }
        else
        {
            <LineupSummary Game="game" Picks="Picks().ToList()" Rules="Session.Rules" JustSaved="_justSaved" OnEdit="Edit" GameId="GameId" />
        }
    </ChildContent>
</ParticipantShell>

@code {
    [Parameter]
    public Guid GameId { get; set; }

    private bool _editing;
    private bool _justSaved;
    private bool _saving;
    private string? _saveError;
    private string _search = string.Empty;
    private string? _group;
    private List<string> _groups = [];
    private List<Guid> _picked = [];
    private Guid? _captain;

    private IEnumerable<AvailableElement> FilteredElements =>
        (Session.Elements ?? []).Where(e =>
            (_group is null || e.Group == _group) &&
            (string.IsNullOrWhiteSpace(_search)
                || e.Name.Contains(_search, StringComparison.CurrentCultureIgnoreCase)
                || (e.Subtitle?.Contains(_search, StringComparison.CurrentCultureIgnoreCase) ?? false)
                || (e.Group?.Contains(_search, StringComparison.CurrentCultureIgnoreCase) ?? false)));

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        if (await Session.EnsureLoadedAsync(GameId) != ParticipantSessionStatus.Ready)
        {
            return;
        }

        await Task.WhenAll(Session.LoadElementsAsync(), Session.LoadRulesAsync());
        _groups = (Session.Elements ?? []).Select(e => e.Group).OfType<string>().Where(g => g.Length > 0)
            .Distinct().Order(StringComparer.CurrentCulture).ToList();
        ResetFromSession();
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(() =>
    {
        // The game went live while the participant was looking at the lineup: it is now read-only.
        if (_editing && Session.Game?.IsBeforeStart == false)
        {
            ResetFromSession();
        }
        StateHasChanged();
    });

    private void ResetFromSession()
    {
        var lineup = Session.Lineup;
        _picked = lineup?.PickedElementIds.ToList() ?? [];
        _captain = lineup?.CaptainElementId;
        var canEdit = Session.Game?.IsBeforeStart == true && lineup?.IsLocked != true;
        _editing = canEdit && (lineup is null || lineup.PickedElementIds.Count == 0);
    }

    private ElementPickState StateOf(Guid id) =>
        !_picked.Contains(id) ? ElementPickState.Free
        : _captain == id && Session.Game?.CaptainEnabled == true ? ElementPickState.Captain
        : ElementPickState.Picked;

    private static string? Subtitle(AvailableElement element) =>
        string.Join(", ", new[] { element.Group, element.Subtitle }.Where(s => !string.IsNullOrWhiteSpace(s))) is { Length: > 0 } text ? text : null;

    private void Toggle(Guid id, GameInfo game)
    {
        _saveError = null;
        if (_picked.Remove(id))
        {
            if (_captain == id)
            {
                _captain = game.CaptainEnabled && _picked.Count > 0 ? _picked[0] : null;
            }
            return;
        }

        if (_picked.Count < game.LineupSize)
        {
            _picked.Add(id);
            if (game.CaptainEnabled && _captain is null)
            {
                _captain = id;
            }
        }
    }

    private bool CanSave(GameInfo game) =>
        _picked.Count == game.LineupSize && (!game.CaptainEnabled || (_captain is { } captain && _picked.Contains(captain)));

    private string Hint(GameInfo game)
    {
        var missing = game.LineupSize - _picked.Count;
        var multiplier = ParticipantFormat.Multiplier(game.CaptainMultiplier);
        if (missing > 0)
        {
            var pick = string.Format(Loc[missing == 1 ? "PickOneMore" : "PickMore"], missing);
            return game.CaptainEnabled ? $"{pick} {string.Format(Loc["CaptainScoresMore"], multiplier)}" : pick;
        }
        if (game.CaptainEnabled && Session.Elements?.FirstOrDefault(e => e.Id == _captain) is { } captain)
        {
            return string.Format(Loc["CaptainIs"], captain.Name, multiplier);
        }
        return Loc["LineupComplete"];
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _saveError = null;
        var outcome = await Session.SaveLineupAsync(_picked, Session.Game?.CaptainEnabled == true ? _captain : null);
        _saving = false;

        switch (outcome)
        {
            case SaveLineupOutcome.Saved:
                _editing = false;
                _justSaved = true;
                break;
            case SaveLineupOutcome.Rejected:
                _saveError = Loc["SaveFailed"];
                break;
            default:
                _saveError = Loc["SaveNetworkError"];
                break;
        }
    }

    private void Edit()
    {
        _justSaved = false;
        _editing = true;
    }

    private IEnumerable<LineupPick> Picks()
    {
        var lineup = Session.Lineup;
        if (lineup is null)
        {
            yield break;
        }

        var scores = Session.Leaderboard?.MyPosition?.ElementScores ?? [];
        foreach (var id in lineup.PickedElementIds)
        {
            var element = Session.Elements?.FirstOrDefault(e => e.Id == id);
            var name = element?.Name ?? scores.FirstOrDefault(s => s.ElementId == id)?.Name ?? string.Empty;
            yield return new LineupPick(id, name, element?.ImageUrl, id == lineup.CaptainElementId && Session.Game?.CaptainEnabled == true);
        }
    }
}
