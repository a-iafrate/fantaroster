@page "/games/{GameId:guid}/leaderboard"
@rendermode ClientRenderMode.Instance
@implements IDisposable
@inject ParticipantSession Session
@inject IStringLocalizer<ParticipantResource> Loc

<PageTitle>@Loc["TabLeaderboard"]</PageTitle>

<ParticipantShell GameId="GameId" Tab="ParticipantTab.Leaderboard">
    <HeaderExtra>
        @if (Session.Game?.IsLive == true)
        {
            <span class="ds-badge ds-badge--surface"><span class="ds-live-dot" aria-hidden="true"></span>@Loc["LiveBadge"]</span>
        }
    </HeaderExtra>
    <ChildContent>
        @if (Session.Game is { } game && Session.Leaderboard is { } board)
        {
            var me = board.MyPosition;
            var top = board.TopPositions.OrderBy(p => p.Rank).ToList();

            @if (game.IsBeforeStart)
            {
                <p class="ds-alert ds-alert--info">@Loc["LeaderboardStartsLater"]</p>
            }
            else if (game.IsOver)
            {
                <div class="final">
                    <span class="ds-badge"><i class="icon-flag" aria-hidden="true"></i>@Loc["GameOverBadge"]</span>
                    <h2 class="final__title">
                        @(me is null ? Loc["FinalLeaderboard"] : string.Format(Loc["FinishedRank"], me.Rank, board.TotalParticipants))
                    </h2>

                    @if (top.Count > 0)
                    {
                        <ol class="podium" aria-label="@Loc["Podium"]">
                            @foreach (var (entry, place) in Podium(top))
                            {
                                <li class="podium__step podium__step--@place">
                                    <Avatar Name="@entry.Nickname" Seed="@entry.ParticipantId.ToString()" Size="@(place == 1 ? AvatarSize.L : AvatarSize.M)" />
                                    <span class="podium__name">@entry.Nickname</span>
                                    <span class="podium__block">
                                        @if (place == 1)
                                        {
                                            <i class="icon-trophy" aria-hidden="true"></i>
                                        }
                                        <span class="podium__rank">@entry.Rank</span>
                                        <span class="podium__score">@string.Format(Loc["PointsShort"], entry.TotalScore)</span>
                                    </span>
                                </li>
                            }
                        </ol>
                    }

                    @if (me is not null)
                    {
                        <div class="me-card me-card--final">
                            <span class="me-card__rank">@string.Format(Loc["RankOrdinal"], me.Rank)</span>
                            <div class="me-card__who">
                                <div class="me-card__name">@string.Format(Loc["NicknameWithPoints"], me.Nickname, me.TotalScore)</div>
                                @if (me.ElementScores.OrderByDescending(s => s.Score).FirstOrDefault() is { } mvp)
                                {
                                    <div class="me-card__line">
                                        @string.Format(Loc[mvp.IsCaptain ? "MvpCaptain" : "Mvp"], mvp.Name, mvp.Score)
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @if (top.Count > 3)
                    {
                        <ol class="board" aria-label="@Loc["FinalLeaderboard"]">
                            @foreach (var entry in top.Skip(3))
                            {
                                <LeaderboardRow Entry="entry" IsMe="@(entry.ParticipantId == me?.ParticipantId)" />
                            }
                        </ol>
                    }
                </div>
            }
            else
            {
                @if (me is not null)
                {
                    <section class="me-card" aria-label="@Loc["MyPosition"]">
                        <div class="me-card__head">
                            <span class="me-card__rank">@string.Format(Loc["RankOrdinal"], me.Rank)</span>
                            <div class="me-card__who">
                                <div class="me-card__name">@me.Nickname</div>
                                <div class="me-card__line">@PodiumLine(me, top)</div>
                            </div>
                            <span class="me-card__score">@me.TotalScore</span>
                        </div>
                        @if (me.ElementScores.Count > 0)
                        {
                            <ul class="me-card__picks" aria-label="@Loc["PointsByPick"]">
                                @foreach (var pick in me.ElementScores.OrderByDescending(s => s.IsCaptain))
                                {
                                    <li class="me-card__pick">
                                        <span class="me-card__pick-name">
                                            @if (pick.IsCaptain)
                                            {
                                                <i class="icon-star" aria-hidden="true"></i><span class="visually-hidden">@Loc["Captain"]: </span>
                                            }
                                            @pick.Name
                                        </span>
                                        <span class="me-card__pick-score">@pick.Score</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="me-card__line">@Loc["NoLineupSaved"]</p>
                        }
                    </section>
                }

                @if (top.Count == 0 || top.All(p => p.TotalScore == 0))
                {
                    <p class="ds-muted board__empty">@Loc["NoScoresYet"]</p>
                }

                @if (top.Count > 0)
                {
                    <h2 class="board__heading">@string.Format(Loc["TopN"], top.Count)</h2>
                    <ol class="board">
                        @foreach (var entry in top)
                        {
                            Session.RankChanges.TryGetValue(entry.ParticipantId, out var change);
                            <LeaderboardRow Entry="entry" IsMe="@(entry.ParticipantId == me?.ParticipantId)" Change="change" />
                        }
                    </ol>
                }
            }
        }
        else
        {
            <div class="board__skeleton" role="status"><span class="visually-hidden">@Loc["Loading"]</span></div>
        }
    </ChildContent>
</ParticipantShell>

@code {
    [Parameter]
    public Guid GameId { get; set; }

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    private string PodiumLine(LeaderboardEntry me, IReadOnlyList<LeaderboardEntry> top)
    {
        if (me.Rank <= 3)
        {
            return Loc["OnThePodium"];
        }
        var third = top.Count >= 3 ? top[2].TotalScore : 0;
        return string.Format(Loc["PointsFromPodium"], Math.Max(third - me.TotalScore, 0));
    }

    /// <summary>Second, first, third: the classic podium order, left to right.</summary>
    private static IEnumerable<(LeaderboardEntry Entry, int Place)> Podium(IReadOnlyList<LeaderboardEntry> top)
    {
        if (top.Count > 1)
        {
            yield return (top[1], 2);
        }
        yield return (top[0], 1);
        if (top.Count > 2)
        {
            yield return (top[2], 3);
        }
    }
}
