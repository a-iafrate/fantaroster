@page "/games/{GameId:guid}/join"
@rendermode ClientRenderMode.Instance
@inject HttpClient Http
@inject ParticipantAuthState AuthState
@inject ParticipantSession Session
@inject NavigationManager Navigation
@inject IStringLocalizer<ParticipantResource> Loc

<PageTitle>@Loc["JoinPageTitle"]</PageTitle>

@* Mockup 02, screen 01: join from the QR code with a nickname, no account. *@
<div class="join">
    <img class="join__logo" src="assets/logo-r.svg" alt="" />

    @switch (Session.Status)
    {
        case ParticipantSessionStatus.Loading:
            <div class="join__skeleton" role="status"><span class="visually-hidden">@Loc["Loading"]</span></div>
            break;

        case ParticipantSessionStatus.NotFound:
            <h1 class="ds-title">@Loc["GameNotFoundTitle"]</h1>
            <p class="ds-muted">@Loc["GameNotFoundHelp"]</p>
            <a href="/j" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary">@Loc["EnterCodeTitle"]</a>
            break;

        case ParticipantSessionStatus.Error:
            <h1 class="ds-title">@Loc["LoadFailedTitle"]</h1>
            <p class="ds-muted">@Loc["NetworkErrorTryAgain"]</p>
            <button type="button" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary" @onclick="LoadAsync">@Loc["Retry"]</button>
            break;

        default:
            if (Session.Game is { } game)
            {
                @if (Session.Elements is { Count: > 0 } elements)
                {
                    <div class="join__fan" aria-hidden="true">
                        @foreach (var element in elements.Take(3))
                        {
                            <span class="join__fan-card">
                                <Avatar Name="@element.Name" Seed="@element.Id.ToString()" ImageUrl="@element.ImageUrl" Size="AvatarSize.L" />
                            </span>
                        }
                    </div>
                }

                <div class="join__intro">
                    <h1 class="join__game">@game.Name</h1>
                    <p class="ds-muted join__desc">@Description(game)</p>
                </div>

                @if (!game.IsBeforeStart && !game.IsLive)
                {
                    <p class="ds-alert ds-alert--info">@Loc["GameClosedHelp"]</p>
                }
                else if (game.State == "Draft")
                {
                    <p class="ds-alert ds-alert--info">@Loc["GameNotOpenHelp"]</p>
                }
                else
                {
                    <form class="join__form" @onsubmit="JoinAsync" novalidate>
                        <div>
                            <label class="ds-label" for="nickname">@Loc["Nickname"]</label>
                            <input id="nickname" class="ds-input" type="text" autocomplete="nickname" maxlength="50" required
                                   aria-describedby="nickname-hint @(_error is null ? null : "nickname-error")"
                                   aria-invalid="@(_error is null ? null : "true")"
                                   placeholder="@Loc["NicknamePlaceholder"]"
                                   @bind="_nickname" @bind:event="oninput" />
                            <p class="ds-hint" id="nickname-hint">@Loc["NicknameHint"]</p>
                            @if (_error is not null)
                            {
                                <p class="ds-alert" id="nickname-error" role="alert">@_error</p>
                            }
                        </div>
                        <button type="submit" class="ds-btn ds-btn--l ds-btn--block ds-btn--primary" disabled="@_submitting">
                            @(_submitting ? Loc["Joining"] : Loc["JoinButton"])
                        </button>
                        <p class="join__legal">@Loc["JoinLegal"]</p>
                    </form>
                }
            }
            break;
    }
</div>

@code {
    private const int MinNicknameLength = 2;
    private const int MaxNicknameLength = 50;

    [Parameter]
    public Guid GameId { get; set; }

    private string _nickname = string.Empty;
    private string? _error;
    private bool _submitting;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var status = await Session.EnsureLoadedAsync(GameId);
        if (status == ParticipantSessionStatus.Ready)
        {
            // Already joined on this device.
            Navigation.NavigateTo(ParticipantRoutes.Home(GameId), replace: true);
            return;
        }

        if (status == ParticipantSessionStatus.NeedsJoin)
        {
            try
            {
                await Session.LoadElementsAsync();
            }
            catch (HttpRequestException)
            {
                // The decorative cards are optional.
            }
        }
    }

    private string Description(GameInfo game)
    {
        var plural = game.Terms.ElementPlural.ToLower(System.Globalization.CultureInfo.CurrentCulture);
        var pick = Session.Elements is { Count: > 0 } elements
            ? string.Format(Loc["PickNOfTotal"], game.LineupSize, plural, elements.Count)
            : string.Format(Loc["PickN"], game.LineupSize, plural);
        return game.CaptainEnabled
            ? $"{pick} {string.Format(Loc["CaptainScoresMore"], ParticipantFormat.Multiplier(game.CaptainMultiplier))}"
            : pick;
    }

    private async Task JoinAsync()
    {
        _error = null;
        var nickname = _nickname.Trim();
        if (nickname.Length is < MinNicknameLength or > MaxNicknameLength)
        {
            _error = Loc["NicknameInvalid"];
            return;
        }

        _submitting = true;
        try
        {
            using var response = await Http.PostAsJsonAsync($"/api/games/{GameId}/participant/join", new { nickname });
            if (response.IsSuccessStatusCode && await response.Content.ReadFromJsonAsync<JoinResponse>() is { Token: { Length: > 0 } token })
            {
                await AuthState.SetTokenAsync(token);
                Navigation.NavigateTo(ParticipantRoutes.Home(GameId));
                return;
            }

            _error = response.StatusCode switch
            {
                System.Net.HttpStatusCode.Conflict => Loc["NicknameTaken"],
                System.Net.HttpStatusCode.BadRequest => Loc["NicknameInvalid"],
                _ => Loc["JoinFailed"],
            };
        }
        catch (HttpRequestException)
        {
            _error = Loc["NetworkErrorTryAgain"];
        }
        finally
        {
            _submitting = false;
        }
    }

    private sealed record JoinResponse(string? Token);
}
