@page "/games/{GameId:guid}/join"
@rendermode ParticipantRenderMode.Instance
@inject HttpClient Http
@inject Roster.Web.Client.Services.ParticipantAuthState AuthState
@inject NavigationManager Navigation
@inject IStringLocalizer<ParticipantResource> Loc

<PageTitle>@Loc["JoinPageTitle"]</PageTitle>

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    @if (_isLoading)
                    {
                        <div class="text-center">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@Loc["Loading"]</span>
                            </div>
                        </div>
                    }
                    else if (_gameNotFound)
                    {
                        <h2 class="card-title text-center mb-3">@Loc["GameNotFoundTitle"]</h2>
                        <p class="text-center text-muted mb-4">@Loc["GameNotFoundHelp"]</p>
                        <a href="/j" class="btn btn-primary w-100">@Loc["EnterCodeTitle"]</a>
                    }
                    else if (_notJoinable is not null)
                    {
                        <h2 class="card-title text-center mb-3">@Loc[_notJoinable == "Draft" ? "GameNotOpenTitle" : "GameClosedTitle"]</h2>
                        <p class="text-center text-muted mb-0">@Loc[_notJoinable == "Draft" ? "GameNotOpenHelp" : "GameClosedHelp"]</p>
                    }
                    else
                    {
                    <h2 class="card-title text-center mb-4">@Loc["JoinTitle"]</h2>

                    @if (!string.IsNullOrEmpty(_errorMessage))
                    {
                        <div class="alert alert-danger">
                            @_errorMessage
                        </div>
                    }

                    <EditForm Model="@_model" OnSubmit="HandleSubmit">

                        <div class="mb-3">
                            <label for="nickname" class="form-label">@Loc["Nickname"]</label>
                            <InputText id="nickname" class="form-control" @bind-Value="_model.Nickname" placeholder="@Loc["NicknamePlaceholder"]" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100" disabled="@_isSubmitting">
                            @if (_isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>@Loc["Joining"]</span>
                            }
                            else
                            {
                                <span>@Loc["JoinButton"]</span>
                            }
                        </button>
                    </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public Guid GameId { get; set; }

    private JoinGameViewModel _model = new();
    private bool _isSubmitting;
    private bool _isLoading = true;
    private bool _gameNotFound;
    private string? _notJoinable;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetAsync($"/api/games/{GameId}");
            if (response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _gameNotFound = true;
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var game = await response.Content.ReadFromJsonAsync<GameInfoViewModel>();
                if (game is not null && game.State is not ("Open" or "Live"))
                {
                    _notJoinable = game.State;
                }
            }
        }
        catch (HttpRequestException)
        {
            // Offline or server unreachable: show the form and let the submit report the network error.
        }
        finally
        {
            _isLoading = false;
        }

        // If already joined, go straight to the game view.
        var token = await AuthState.GetTokenAsync();
        if (!string.IsNullOrEmpty(token))
        {
            Navigation.NavigateTo($"/games/{GameId}");
        }
    }

    private async Task HandleSubmit()
    {
        _errorMessage = null;

        var nickname = _model.Nickname.Trim();
        if (nickname.Length is < 2 or > 50)
        {
            _errorMessage = Loc["NicknameInvalid"];
            return;
        }

        _isSubmitting = true;

        try
        {
            var response = await Http.PostAsJsonAsync($"/api/games/{GameId}/participant/join", new { nickname });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<JoinResponse>();
                if (result?.Token != null)
                {
                    await AuthState.SetTokenAsync(result.Token);
                    Navigation.NavigateTo($"/games/{GameId}");
                }
                else
                {
                    _errorMessage = Loc["JoinInvalidResponse"];
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<ErrorResponse>();
                _errorMessage = errorResult?.Error ?? Loc["JoinFailed"];
            }
        }
        catch (Exception)
        {
            _errorMessage = Loc["NetworkErrorTryAgain"];
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    public class GameInfoViewModel
    {
        public string State { get; set; } = string.Empty;
    }

    public class JoinGameViewModel
    {
        public string Nickname { get; set; } = string.Empty;
    }

    public class JoinResponse
    {
        public string? Token { get; set; }
    }

    public class ErrorResponse
    {
        public string? Error { get; set; }
    }
}
