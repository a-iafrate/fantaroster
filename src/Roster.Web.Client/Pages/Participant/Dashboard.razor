@page "/games/{GameId:guid}"
@rendermode ClientRenderMode.Instance
@inject ParticipantSession Session
@inject NavigationManager Navigation
@inject IStringLocalizer<ParticipantResource> Loc

@* Entry point of a game: before the start the participant builds the lineup, afterwards
   the leaderboard is the main view. The shell renders loading, not-found and error states. *@
<PageTitle>@Loc["TabLineup"]</PageTitle>

<ParticipantShell GameId="GameId" Tab="ParticipantTab.Lineup" />

@code {
    [Parameter]
    public Guid GameId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var status = await Session.EnsureLoadedAsync(GameId);
        if (status == ParticipantSessionStatus.Ready && Session.Game is { } game)
        {
            var tab = game.IsBeforeStart ? ParticipantTab.Lineup : ParticipantTab.Leaderboard;
            Navigation.NavigateTo(ParticipantRoutes.For(GameId, tab), replace: true);
        }
    }
}
