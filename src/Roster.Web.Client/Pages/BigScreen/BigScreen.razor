@page "/games/{GameId:guid}/big-screen"
@rendermode ClientRenderMode.Instance
@using System.Net.Http.Json
@using Roster.Web.Client.Pages.BigScreen.Components
@implements IAsyncDisposable
@inject HttpClient Http
@inject NavigationManager Nav
@inject GameHubClient HubClient
@inject TimeProvider Time
@inject IJSRuntime JS
@inject IStringLocalizer<StageResource> Loc

<PageTitle>@Loc["PageTitle"]</PageTitle>

@* Big screen (mockup 04, screens 15 and 16): 1920x1080 in the "stage" theme, scaled to any 16:9 display.
   No fixed menu: the controls appear with the mouse or a key and hide after three seconds. *@
<div class="stage @(_controlsVisible ? "" : "stage--idle")" tabindex="0" @ref="_root" @onkeydown="OnKeyDown" @onmousemove="ShowControls">
    @if (_game is null)
    {
        <p class="stage__message loading" role="status">@(_notFound ? Loc["NotFound"] : Loc["Loading"])</p>
    }
    else if (ShowJoin)
    {
        <section class="join" aria-label="@Loc["JoinTitle"]">
            <div class="join__text">
                <div class="stage__brand"><img src="assets/logo-r.svg" alt="" /><Wordmark Name="@_game.BrandName" /></div>
                <h1 class="join__headline">@Loc["StillTime"]</h1>
                <p class="join__body">@JoinBody()</p>
                <div class="join__pills">
                    <span class="pill pill--white"><i class="icon-users" aria-hidden="true"></i>@string.Format(Loc["PlayersCount"], _total)</span>
                    @if (_game.IsBeforeStart)
                    {
                        <span class="pill pill--lime"><i class="icon-clock" aria-hidden="true"></i>@Loc["RostersOpen"]</span>
                    }
                </div>
            </div>
            <div class="join__qr">
                <span class="join__card join__card--cyan" aria-hidden="true"></span>
                <span class="join__card join__card--blue" aria-hidden="true"></span>
                <div class="join__card join__card--main">
                    <QrView Text="@_joinUrl" />
                    <div class="join__host">@Host</div>
                    <div class="join__code" aria-label="@Loc["JoinTitle"]">@_game.JoinCode</div>
                </div>
            </div>
        </section>
    }
    else
    {
        <header class="stage__bar">
            <div class="stage__brand"><img src="assets/logo-r.svg" alt="" /><Wordmark Name="@_game.BrandName" /></div>
            <span class="stage__game">@_game.Name</span>
            <span class="pill pill--white stage__live"><span class="stage__dot stage__dot--@(_game.IsLive ? "live" : "idle")" aria-hidden="true"></span>@StateLabel()</span>
        </header>

        <section class="board" aria-label="@Loc["ModeLeaderboard"]">
            @if (_moment is not null)
            {
                <div class="board__moment" role="status"><i class="icon-arrow-up" aria-hidden="true"></i>@_moment</div>
            }
            @if (_rows.Count == 0)
            {
                <p class="board__empty">@Loc["Waiting"]</p>
            }
            <ol class="board__rows">
                @foreach (var row in _rows)
                {
                    <li class="row row--@row.Index @(row.Entry.ParticipantId == _liftedId ? "row--lift" : "")" @key="row.Entry.ParticipantId">
                        <span class="row__rank"><span class="visually-hidden">@Loc["Rank"] </span>@row.Entry.Rank</span>
                        <span class="row__change @(row.Change > 0 ? "row__change--up" : row.Change < 0 ? "row__change--down" : "")">
                            @if (row.Change != 0)
                            {
                                <i class="@(row.Change > 0 ? "icon-arrow-up" : "icon-arrow-down")" aria-hidden="true"></i>@Math.Abs(row.Change)
                                <span class="visually-hidden">@(row.Change > 0 ? string.Format(Loc["MovedUp"], row.Change) : string.Format(Loc["MovedDown"], -row.Change))</span>
                            }
                        </span>
                        <span class="row__avatar avatar-@AvatarIndex(row.Entry.ParticipantId)" aria-hidden="true">@Initials(row.Entry.Nickname)</span>
                        <span class="row__name">@row.Entry.Nickname</span>
                        <span class="row__score">@row.Entry.TotalScore</span>
                    </li>
                }
            </ol>
        </section>

        <aside class="side">
            <div class="side__join">
                <div class="side__title">@Loc["JoinTitle"]</div>
                <QrView Text="@_joinUrl" />
                <div class="side__host">@Host</div>
                <div class="side__code">@_game.JoinCode</div>
            </div>
            <div class="side__count">
                <div class="side__count-label">@Loc["Players"]</div>
                <div class="side__count-value">@_total</div>
            </div>
        </aside>

        <footer class="ticker" aria-label="@Loc["LatestPoints"]">
            <span class="ticker__tag">@Loc["LatestPoints"]</span>
            @foreach (var item in TickerItems())
            {
                <span class="ticker__item @(item.Points < 0 ? "ticker__item--penalty" : "")">
                    <span class="ticker__points">@ParticipantFormat.Points(item.Points)</span>
                    <span class="ticker__who">@item.Who</span>
                    <span class="ticker__rule">@item.Rule</span>
                </span>
            }
        </footer>
    }

    <div class="controls @(_controlsVisible ? "controls--visible" : "")" role="toolbar" aria-label="@Loc["Controls"]">
        @foreach (var mode in Modes)
        {
            <button type="button" class="controls__btn @(_mode == mode ? "controls__btn--on" : "")" aria-pressed="@(_mode == mode ? "true" : "false")" @onclick="() => SetMode(mode)">
                @ModeLabel(mode)
            </button>
        }
        <button type="button" class="controls__btn" aria-pressed="@(_paused ? "true" : "false")" @onclick="TogglePause">@(_paused ? Loc["Resume"] : Loc["Pause"])</button>
        <button type="button" class="controls__btn" @onclick="FullscreenAsync">@Loc["Fullscreen"]</button>
        <span class="controls__hint">@Loc["Shortcuts"]</span>
    </div>
</div>

@code {
    private enum StageMode { Leaderboard, Join, Auto }

    private sealed record Row(int Index, LeaderboardEntry Entry, int Change);

    private sealed record TickerItem(string Who, string Rule, int Points);

    private const int RowCount = 8;
    private const int TickerCount = 3;
    private static readonly StageMode[] Modes = [StageMode.Leaderboard, StageMode.Join, StageMode.Auto];
    private static readonly TimeSpan ControlsHideAfter = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan MomentDuration = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan LiftDuration = TimeSpan.FromMilliseconds(1200);
    private static readonly TimeSpan BoardDuration = TimeSpan.FromSeconds(20);
    private static readonly TimeSpan JoinDuration = TimeSpan.FromSeconds(10);

    [Parameter] public Guid GameId { get; set; }

    private GameInfo? _game;
    private bool _notFound;
    private string _joinUrl = string.Empty;
    private int _total;
    private List<Row> _rows = [];
    private Dictionary<Guid, int> _previousRanks = [];
    private List<RefereeEntry> _recent = [];
    private IReadOnlyList<AvailableElement> _elements = [];
    private IReadOnlyList<GameRule> _rules = [];
    private long _version = -1;

    private StageMode _mode = StageMode.Auto;
    private bool _paused;
    private bool _autoShowsJoin;
    private TimeSpan _autoElapsed;
    // Hidden until the mouse moves or a key is pressed: a projector must not show UI by itself.
    private bool _controlsVisible;
    private string? _moment;
    private Guid? _liftedId;
    private ElementReference _root;
    private ITimer? _clock;
    private ITimer? _hideControls;
    private ITimer? _hideMoment;
    private ITimer? _hideLift;
    private bool _focusRoot;

    private string Host => new Uri(Nav.Uri).Authority;

    /// <summary>Before the start there is nothing to rank: the join screen is the whole point of the display.</summary>
    private bool ShowJoin => _mode == StageMode.Join
        || (_mode == StageMode.Auto && (_game?.IsBeforeStart == true || _autoShowsJoin));

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        _joinUrl = $"{uri.Scheme}://{uri.Authority}/games/{GameId}/join";
        _mode = uri.Query.Contains("mode=join", StringComparison.OrdinalIgnoreCase) ? StageMode.Join : StageMode.Auto;

        HubClient.OnLeaderboardUpdated += OnHubEvent;
        HubClient.OnScoreEntryAdded += OnHubEvent;
        HubClient.OnScoreEntryVoided += OnHubEvent;
        HubClient.OnGameStateChanged += OnGameState;
        HubClient.OnReconnected += OnReconnected;

        await LoadAsync();
        await HubClient.StartAsync(GameId);

        _clock = Time.CreateTimer(_ => InvokeAsync(Tick), null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
        _hideControls = Time.CreateTimer(_ => InvokeAsync(HideControls), null, Timeout.InfiniteTimeSpan, Timeout.InfiniteTimeSpan);
        _focusRoot = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusRoot)
        {
            _focusRoot = false;
            await _root.FocusAsync();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            using var gameResponse = await Http.GetAsync(new Uri($"/api/games/{GameId}", UriKind.Relative));
            if (gameResponse.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _notFound = true;
                return;
            }
            gameResponse.EnsureSuccessStatusCode();
            _game = await gameResponse.Content.ReadFromJsonAsync<GameInfo>();

            _elements = await Http.GetFromJsonAsync<List<AvailableElement>>($"/api/games/{GameId}/elements") ?? [];
            _rules = await Http.GetFromJsonAsync<List<GameRule>>($"/api/games/{GameId}/rules") ?? [];
            await RefreshBoardAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // Kiosk: keep what is on screen and retry on the next event or reconnection.
        }
    }

    private async Task RefreshBoardAsync()
    {
        // The big screen has no participant: the anonymous projection of the leaderboard is enough.
        var board = await Http.GetFromJsonAsync<LeaderboardResponse>($"/api/games/{GameId}/leaderboard");
        _recent = await Http.GetFromJsonAsync<List<RefereeEntry>>($"/api/games/{GameId}/score-entries?count=10") ?? [];
        if (board is null || board.Version < _version)
        {
            return;
        }

        _version = board.Version;
        _total = board.TotalParticipants;

        var top = board.TopPositions.OrderBy(p => p.Rank).Take(RowCount).ToList();
        var rows = new List<Row>();
        Row? biggestClimb = null;
        for (var i = 0; i < top.Count; i++)
        {
            var change = _previousRanks.TryGetValue(top[i].ParticipantId, out var before) ? before - top[i].Rank : 0;
            var row = new Row(i, top[i], change);
            rows.Add(row);
            if (change > 0 && (biggestClimb is null || change > biggestClimb.Change))
            {
                biggestClimb = row;
            }
        }

        _previousRanks = board.TopPositions.ToDictionary(p => p.ParticipantId, p => p.Rank);
        _rows = rows;

        if (biggestClimb is not null)
        {
            AnnounceClimb(biggestClimb);
        }
        StateHasChanged();
    }

    private void AnnounceClimb(Row row)
    {
        _moment = string.Format(Loc["Climbs"], row.Entry.Nickname, row.Change);
        _liftedId = row.Entry.ParticipantId;
        _hideMoment?.Dispose();
        _hideMoment = Time.CreateTimer(_ => InvokeAsync(() => { _moment = null; StateHasChanged(); }), null, MomentDuration, Timeout.InfiniteTimeSpan);
        _hideLift?.Dispose();
        _hideLift = Time.CreateTimer(_ => InvokeAsync(() => { _liftedId = null; StateHasChanged(); }), null, LiftDuration, Timeout.InfiniteTimeSpan);
    }

    private async void OnHubEvent(long _) => await RefreshSafelyAsync();

    private async void OnHubEvent(Guid _) => await RefreshSafelyAsync();

    private async void OnGameState(string state)
    {
        if (_game is not null)
        {
            _game = _game with { State = state };
            await InvokeAsync(StateHasChanged);
        }
    }

    private async void OnReconnected() => await RefreshSafelyAsync();

    private async Task RefreshSafelyAsync()
    {
        try
        {
            await InvokeAsync(RefreshBoardAsync);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // Offline: the next event catches up.
        }
    }

    private void Tick()
    {
        if (_mode != StageMode.Auto || _paused || _game is null || _game.IsBeforeStart)
        {
            return;
        }

        _autoElapsed += TimeSpan.FromSeconds(1);
        var limit = _autoShowsJoin ? JoinDuration : BoardDuration;
        if (_autoElapsed >= limit)
        {
            _autoShowsJoin = !_autoShowsJoin;
            _autoElapsed = TimeSpan.Zero;
        }
        StateHasChanged();
    }

    private IEnumerable<TickerItem> TickerItems() => _recent
        .Where(e => e.Status != "Voided")
        .Take(TickerCount)
        .Select(e => new TickerItem(
            _elements.FirstOrDefault(el => el.Id == e.ElementId)?.Name ?? string.Empty,
            _rules.FirstOrDefault(r => r.Id == e.RuleId)?.Label ?? string.Empty,
            e.PointsSnapshot));

    private string StateLabel() => _game!.IsLive ? Loc["Live"] : _game.IsOver ? Loc["Ended"] : Loc["NotStarted"];

    private string JoinBody()
    {
        var plural = _game!.Terms.ElementPlural.ToLower(System.Globalization.CultureInfo.CurrentCulture);
        return string.Format(Loc[_game.CaptainEnabled ? "StillTimeBodyCaptain" : "StillTimeBody"], _game.LineupSize, plural);
    }

    private string ModeLabel(StageMode mode) => mode switch
    {
        StageMode.Leaderboard => Loc["ModeLeaderboard"],
        StageMode.Join => Loc["ModeJoin"],
        _ => Loc["ModeAuto"],
    };

    private void SetMode(StageMode mode)
    {
        _mode = mode;
        _autoShowsJoin = false;
        _autoElapsed = TimeSpan.Zero;
    }

    private void TogglePause() => _paused = !_paused;

    private async Task FullscreenAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("document.documentElement.requestFullscreen");
        }
        catch (JSException)
        {
            // The browser refused (no user gesture): nothing to do.
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        ShowControls();
        switch (e.Key)
        {
            case "f" or "F":
                await FullscreenAsync();
                break;
            case " ":
                TogglePause();
                break;
        }
    }

    private void ShowControls()
    {
        if (!_controlsVisible)
        {
            _controlsVisible = true;
        }
        _hideControls?.Change(ControlsHideAfter, Timeout.InfiniteTimeSpan);
    }

    private void HideControls()
    {
        _controlsVisible = false;
        StateHasChanged();
    }

    private static int AvatarIndex(Guid id) => Roster.Ui.Components.AvatarText.ColorIndex(id.ToString());

    private static string Initials(string name) => Roster.Ui.Components.AvatarText.Initials(name);

    public async ValueTask DisposeAsync()
    {
        HubClient.OnLeaderboardUpdated -= OnHubEvent;
        HubClient.OnScoreEntryAdded -= OnHubEvent;
        HubClient.OnScoreEntryVoided -= OnHubEvent;
        HubClient.OnGameStateChanged -= OnGameState;
        HubClient.OnReconnected -= OnReconnected;
        _clock?.Dispose();
        _hideControls?.Dispose();
        _hideMoment?.Dispose();
        _hideLift?.Dispose();
        await HubClient.DisposeAsync();
    }
}
